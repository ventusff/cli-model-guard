diff --git a/codex-rs/tui/src/chatwidget/model_guard.rs b/codex-rs/tui/src/chatwidget/model_guard.rs
new file mode 100644
index 00000000..89eda489
--- /dev/null
+++ b/codex-rs/tui/src/chatwidget/model_guard.rs
@@ -0,0 +1,438 @@
+//! Model Guard's surface for this widget's thread.
+//!
+//! The guard itself runs where the thread's model requests are made: it holds
+//! the thread on any request for, or disclosure of, a model other than the
+//! user's selection, and only the user's selection lifts the hold. This widget
+//! shows the guard's state, keeps a prompt in the composer while the thread is
+//! held, tells the guard about the user's selections, declines Codex's
+//! automatic model switches, and measures the passive 516 reasoning heuristic,
+//! which holds the thread when configured to.
+//!
+//! The surface participates in Codex's normal layout. It neither controls the
+//! terminal nor selects a thread from background app-server traffic.
+
+use super::*;
+use codex_app_server_protocol::ModelGuardState;
+use codex_app_server_protocol::ModelRoutingUpdatedNotification;
+use codex_app_server_protocol::TokenUsageBreakdown;
+use std::collections::VecDeque;
+use std::io::Read;
+
+pub(crate) use codex_app_server_protocol::ModelGuardHold as Halt;
+
+#[derive(serde::Deserialize)]
+#[serde(default)]
+pub(super) struct GuardSettings {
+    language: String,
+    show_account: bool,
+    /// Also hold the thread on the repeated-516 reasoning heuristic. Off by
+    /// default: the count is a statistical signal, not a disclosed route.
+    halt_on_reasoning_anomaly: bool,
+}
+
+impl Default for GuardSettings {
+    fn default() -> Self {
+        Self {
+            language: "en".into(),
+            show_account: true,
+            halt_on_reasoning_anomaly: false,
+        }
+    }
+}
+
+impl GuardSettings {
+    /// Only this plugin's display preferences are read. Identity comes from
+    /// the native account state; login files and rollouts are never inspected.
+    fn read() -> Self {
+        std::env::var_os("MODEL_GUARD_CODEX_HOME")
+            .map(PathBuf::from)
+            .or_else(|| dirs::home_dir().map(|home| home.join(".local/share/model-guard-codex")))
+            .and_then(|root| {
+                let file = std::fs::File::open(root.join("config.json")).ok()?;
+                serde_json::from_reader(file.take(16 * 1024)).ok()
+            })
+            .unwrap_or_default()
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct Scope {
+    model: String,
+    provider: String,
+    effort: Option<String>,
+    tier: Option<String>,
+}
+
+/// The guard's state for the shown thread and what this widget observes of
+/// its requests.
+pub(super) struct ModelGuard {
+    settings: GuardSettings,
+    /// The guard's state as the process running the thread reports it.
+    pub(super) state: ModelGuardState,
+    /// An automatic switch the widget declined: the blocked model and the offered one.
+    pub(super) refused_switch: Option<(String, String)>,
+    turn_id: Option<String>,
+    running: bool,
+    suspended: bool,
+    route: Option<ModelRoutingUpdatedNotification>,
+    scope: Option<Scope>,
+    turn_scope: Option<Scope>,
+    samples: VecDeque<i64>,
+    seen: VecDeque<String>,
+    last_tokens: Option<i64>,
+    turn_hits: usize,
+}
+
+impl ModelGuard {
+    pub(super) fn new(state: ModelGuardState, settings: GuardSettings) -> Self {
+        Self {
+            settings,
+            state,
+            refused_switch: None,
+            turn_id: None,
+            running: false,
+            suspended: false,
+            route: None,
+            scope: None,
+            turn_scope: None,
+            samples: VecDeque::new(),
+            seen: VecDeque::new(),
+            last_tokens: None,
+            turn_hits: 0,
+        }
+    }
+
+    pub(super) fn language_zh(&self) -> bool {
+        self.settings.language == "zh"
+    }
+
+    pub(super) fn halt(&self) -> Option<&Halt> {
+        self.state.hold.as_ref()
+    }
+
+    fn start_turn(&mut self, turn_id: &str, scope: Scope) {
+        if self.turn_id.as_deref() == Some(turn_id) {
+            return;
+        }
+        self.turn_id = Some(turn_id.to_owned());
+        self.running = true;
+        self.suspended = false;
+        self.route = None;
+        self.turn_hits = 0;
+        if self.turn_scope.as_ref() != Some(&scope) {
+            self.scope = None;
+            self.samples.clear();
+            self.last_tokens = None;
+        }
+        self.turn_scope = Some(scope);
+    }
+
+    fn activate(&mut self, scope: Option<Scope>) {
+        if self.scope != scope {
+            self.scope = scope;
+            self.samples.clear();
+            self.last_tokens = None;
+            self.turn_hits = 0;
+        }
+    }
+
+    pub(super) fn account_changed(&mut self) {
+        self.scope = None;
+        self.samples.clear();
+        self.last_tokens = None;
+        self.turn_hits = 0;
+        self.route = None;
+        self.refused_switch = None;
+        // Responses already in flight can still be billed to the prior login.
+        self.suspended = self.running;
+    }
+
+    fn observe_usage(&mut self, response_id: &str, usage: Option<&TokenUsageBreakdown>) {
+        if response_id.is_empty() || self.seen.iter().any(|id| id == response_id) {
+            return;
+        }
+        self.seen.push_back(response_id.to_owned());
+        if self.seen.len() > 64 {
+            self.seen.pop_front();
+        }
+        self.last_tokens = None;
+        let Some(usage) = usage else { return };
+        let tokens = usage.reasoning_output_tokens;
+        if tokens < 0
+            || tokens > usage.output_tokens
+            || usage.output_tokens > usage.total_tokens
+            || usage.total_tokens <= 0
+        {
+            return;
+        }
+        self.last_tokens = Some(tokens);
+        self.samples.push_back(tokens);
+        if self.samples.len() > 20 {
+            self.samples.pop_front();
+        }
+        self.turn_hits += usize::from(tokens == 516);
+    }
+
+    fn recent_hits(&self) -> usize {
+        self.samples
+            .iter()
+            .rev()
+            .take(5)
+            .filter(|&&n| n == 516)
+            .count()
+    }
+
+    fn alert(&self) -> &'static str {
+        let high = self
+            .scope
+            .as_ref()
+            .and_then(|scope| scope.effort.as_deref())
+            .is_some_and(|effort| matches!(effort, "high" | "xhigh" | "max" | "ultra"));
+        if high && self.samples.len() >= 5 && self.recent_hits() >= 3 {
+            "suspect"
+        } else if high && self.turn_hits > 0 {
+            "watch"
+        } else {
+            "none"
+        }
+    }
+}
+
+impl ChatWidget {
+    fn model_guard_selected_scope(&self) -> Scope {
+        Scope {
+            model: self.current_model().to_owned(),
+            provider: self.config.model_provider_id.clone(),
+            effort: self
+                .current_reasoning_effort()
+                .map(|effort| effort.to_string()),
+            tier: self.effective_service_tier.clone(),
+        }
+    }
+
+    /// Asks the process running the configured thread for the guard's state.
+    /// A widget reconfigured for another thread forgets the previous one's.
+    pub(super) fn model_guard_session_configured(&mut self, previous_thread_id: Option<ThreadId>) {
+        if previous_thread_id != self.thread_id {
+            self.model_guard = None;
+        }
+        if let Some(thread_id) = self.thread_id {
+            self.app_event_tx.send(AppEvent::ModelGuardUpdate {
+                thread_id,
+                select_model: None,
+                reasoning_hits: None,
+            });
+        }
+    }
+
+    /// The guard's state for this thread, `None` when the guard does not
+    /// follow it. A new hold is written to the history unless it arrives in a
+    /// running turn, which it ends and which reports it with its error; the
+    /// reasoning heuristic ends no response, so its hold is always written.
+    pub(crate) fn on_model_guard_state(&mut self, state: Option<ModelGuardState>) {
+        let Some(state) = state else {
+            self.model_guard = None;
+            self.refresh_status_line();
+            self.request_redraw();
+            return;
+        };
+        let (previous, running) = match self.model_guard.as_mut() {
+            Some(guard) => (
+                std::mem::replace(&mut guard.state, state),
+                guard.running && guard.turn_id.is_some(),
+            ),
+            None => {
+                let previous = ModelGuardState {
+                    selected_model: state.selected_model.clone(),
+                    hold: None,
+                };
+                self.model_guard = Some(ModelGuard::new(state, GuardSettings::read()));
+                (previous, false)
+            }
+        };
+        if let Some(guard) = self.model_guard.as_ref()
+            && let Some(halt) = guard.halt()
+            && previous.hold.as_ref() != Some(halt)
+            && (!running || matches!(halt, Halt::Reasoning { .. }))
+        {
+            let message = display::halt_message(halt, guard.language_zh());
+            self.add_error_message(message);
+        }
+        self.refresh_status_line();
+        self.request_redraw();
+    }
+
+    /// The user chose `model`, which the app is telling the guard: the widget
+    /// shows it as the selection at once and drops a declined automatic
+    /// switch; the guard's report follows.
+    pub(crate) fn model_guard_user_selected(&mut self, model: &str) {
+        if let Some(guard) = self.model_guard.as_mut() {
+            guard.state = ModelGuardState {
+                selected_model: model.to_owned(),
+                hold: None,
+            };
+            guard.refused_switch = None;
+        }
+        self.refresh_status_line();
+        self.request_redraw();
+    }
+
+    /// Codex's own switch back to the model it left for Reserve is allowed
+    /// only when that model is the selection; the hold, if any, stays.
+    pub(super) fn model_guard_allows_recovery_to(&self, model: &str) -> bool {
+        self.model_guard
+            .as_ref()
+            .is_none_or(|guard| guard.state.selected_model.eq_ignore_ascii_case(model))
+    }
+
+    /// While the thread is held, the message that explains why input is kept.
+    pub(super) fn model_guard_hold_message(&self) -> Option<String> {
+        let guard = self.model_guard.as_ref()?;
+        Some(display::blocked_message(guard.halt()?, guard.language_zh()))
+    }
+
+    /// Whether `op` would start a turn on a held thread; the message explains why.
+    pub(crate) fn model_guard_block_message(&self, op: &AppCommand) -> Option<String> {
+        matches!(
+            op,
+            AppCommand::UserTurn { .. } | AppCommand::Review { .. } | AppCommand::Compact
+        )
+        .then(|| self.model_guard_hold_message())
+        .flatten()
+    }
+
+    /// Codex offered to switch this thread from `blocked` to `offered` on its
+    /// own. The widget keeps the selection and says so once per offer.
+    pub(super) fn model_guard_refuse_switch(&mut self, blocked: String, offered: String) {
+        let Some(guard) = self.model_guard.as_mut() else {
+            return;
+        };
+        let refused = (blocked, offered);
+        if guard.refused_switch.as_ref() == Some(&refused) {
+            return;
+        }
+        guard.refused_switch = Some(refused.clone());
+        let zh = guard.language_zh();
+        self.add_warning_message(display::refused_switch_message(&refused, zh));
+        self.refresh_status_line();
+    }
+
+    pub(super) fn model_guard_clear_refused_switch(&mut self) {
+        if let Some(guard) = self.model_guard.as_mut() {
+            guard.refused_switch = None;
+        }
+    }
+
+    pub(super) fn restore_model_guard_turn(&mut self, turn: &Turn) {
+        let scope = self.model_guard_selected_scope();
+        if let Some(guard) = self.model_guard.as_mut() {
+            if turn.status == TurnStatus::InProgress {
+                guard.start_turn(&turn.id, scope);
+            } else if guard.turn_id.as_ref() == Some(&turn.id) {
+                guard.running = false;
+            }
+        }
+    }
+
+    pub(super) fn observe_model_guard(
+        &mut self,
+        notification: &ServerNotification,
+        replay_kind: Option<ReplayKind>,
+    ) {
+        let Some(thread) = self.thread_id.map(|id| id.to_string()) else {
+            return;
+        };
+        if let ServerNotification::ThreadModelGuardUpdated(n) = notification {
+            if n.thread_id == thread {
+                self.on_model_guard_state(Some(n.guard.clone()));
+            }
+            return;
+        }
+        if self.model_guard.is_none()
+            || !matches!(
+                notification,
+                ServerNotification::TurnStarted(_)
+                    | ServerNotification::TurnCompleted(_)
+                    | ServerNotification::ModelRoutingUpdated(_)
+                    | ServerNotification::RawResponseCompleted(_)
+            )
+        {
+            return;
+        }
+        if replay_kind.is_some()
+            && !matches!(
+                notification,
+                ServerNotification::TurnStarted(_) | ServerNotification::TurnCompleted(_)
+            )
+        {
+            return;
+        }
+        let current_scope = self.model_guard_selected_scope();
+        let Some(guard) = self.model_guard.as_mut() else {
+            return;
+        };
+        let mut reasoning_hold = None;
+        match notification {
+            ServerNotification::TurnStarted(n) if n.thread_id == thread => {
+                guard.start_turn(&n.turn.id, current_scope);
+            }
+            ServerNotification::TurnCompleted(n)
+                if n.thread_id == thread && guard.turn_id.as_ref() == Some(&n.turn.id) =>
+            {
+                guard.running = false;
+            }
+            ServerNotification::ModelRoutingUpdated(n)
+                if n.thread_id == thread
+                    && guard.turn_id.as_ref() == Some(&n.turn_id)
+                    && guard.running
+                    && !guard.suspended =>
+            {
+                // Requests in flight across an account change are not shown
+                // under the new login; the guard still judges them.
+                guard.activate(Some(Scope {
+                    model: n.requested_model.clone(),
+                    provider: n.model_provider.clone(),
+                    effort: n.reasoning_effort.clone(),
+                    tier: n.service_tier.clone(),
+                }));
+                guard.route = Some(n.clone());
+            }
+            ServerNotification::RawResponseCompleted(n)
+                if n.thread_id == thread
+                    && guard.turn_id.as_ref() == Some(&n.turn_id)
+                    && guard.running
+                    && !guard.suspended =>
+            {
+                // An attached active request may have started before this UI
+                // subscribed. Do not guess its model/effort from current settings.
+                if guard.route.is_none() {
+                    guard.activate(None);
+                }
+                guard.observe_usage(&n.response_id, n.usage.as_ref());
+                if guard.settings.halt_on_reasoning_anomaly
+                    && guard.alert() == "suspect"
+                    && guard.halt().is_none()
+                {
+                    reasoning_hold = u32::try_from(guard.recent_hits()).ok();
+                }
+            }
+            _ => return,
+        }
+        if let (Some(hits), Some(thread_id)) = (reasoning_hold, self.thread_id) {
+            self.app_event_tx.send(AppEvent::ModelGuardUpdate {
+                thread_id,
+                select_model: None,
+                reasoning_hits: Some(hits),
+            });
+        }
+        self.refresh_status_line();
+        self.request_redraw();
+    }
+}
+
+#[path = "model_guard_display.rs"]
+mod display;
+
+#[cfg(test)]
+#[path = "model_guard_tests.rs"]
+mod tests;
diff --git a/codex-rs/tui/src/chatwidget/model_guard_display.rs b/codex-rs/tui/src/chatwidget/model_guard_display.rs
new file mode 100644
index 00000000..5c850321
--- /dev/null
+++ b/codex-rs/tui/src/chatwidget/model_guard_display.rs
@@ -0,0 +1,406 @@
+//! Native footer content and on-demand evidence details.
+use super::*;
+use crate::bottom_pane::StatusLineItem;
+use crate::chatwidget::rate_limits::limit_label_for_window;
+use crate::chatwidget::status_surfaces::five_hour_status_window;
+use crate::chatwidget::status_surfaces::weekly_status_window;
+use ratatui::style::Color;
+
+impl ChatWidget {
+    // Truecolor on purpose: a terminal theme can remap the ANSI palette until a
+    // red alarm renders as pink; the guard's warnings must stay red everywhere.
+    #[allow(clippy::disallowed_methods)]
+    pub(in crate::chatwidget) fn model_guard_lines(&self) -> Option<Vec<Line<'static>>> {
+        let guard = self.model_guard.as_ref()?;
+        let zh = guard.settings.language == "zh";
+        let running = guard.running && !guard.suspended;
+        let active = running.then_some(guard.route.as_ref()).flatten();
+        let (model, effort) = if let Some(route) = active {
+            (
+                route.requested_model.as_str(),
+                route.reasoning_effort.clone(),
+            )
+        } else {
+            (
+                self.current_model(),
+                self.current_reasoning_effort()
+                    .map(|effort| effort.to_string()),
+            )
+        };
+        let mut parts = vec![format!(
+            "{} {model}",
+            if active.is_some() {
+                if zh { "请求" } else { "request" }
+            } else if zh {
+                "已选"
+            } else {
+                "selected"
+            }
+        )];
+        if let Some(effort) = effort {
+            parts.push(effort);
+        }
+        if guard.settings.show_account {
+            if self.config.model_provider_id != "openai" {
+                parts.push(self.config.model_provider_id.clone());
+            } else if let Some(account) = self.status_account_display.as_ref() {
+                match account {
+                    StatusAccountDisplay::ChatGpt { email, plan } => {
+                        parts.extend(email.iter().cloned());
+                        parts.extend(plan.iter().cloned());
+                    }
+                    StatusAccountDisplay::ApiKey => parts.push("API key".into()),
+                }
+            }
+        }
+        if let Some(actual) = active.and_then(|route| route.server_model.as_deref()) {
+            parts.push(format!(
+                "{} {actual}",
+                if zh {
+                    "服务端披露"
+                } else {
+                    "server reported"
+                }
+            ));
+        }
+        let mut lines = vec![Line::from(format!(" {}", safe_label(&parts.join(" · ")))).dim()];
+        let previous = if running {
+            ""
+        } else if zh {
+            "上轮 · "
+        } else {
+            "last turn · "
+        };
+        let evidence_visible =
+            running || guard.turn_scope.as_ref() == Some(&self.model_guard_selected_scope());
+        let reserve = model.eq_ignore_ascii_case(crate::model_catalog::LUNA_RESERVE_MODEL);
+        let warning = if let Some(halt) = guard.halt() {
+            Some(halt_line(halt, zh))
+        } else if reserve {
+            Some(if zh {
+                format!("备用模型 {model} · 这是 Codex 额度用尽时的降级模型 · /model 换回去")
+            } else {
+                format!(
+                    "RESERVE MODEL {model} · Codex's fallback for exhausted usage · /model to leave it"
+                )
+            })
+        } else if !evidence_visible {
+            refused_line(guard, zh)
+        } else if guard.alert() == "suspect" {
+            let hits = guard
+                .samples
+                .iter()
+                .rev()
+                .take(5)
+                .filter(|&&n| n == 516)
+                .count();
+            Some(if zh {
+                format!("{previous}推理异常信号：最近 5 次响应中有 {hits} 次为 516 tokens")
+            } else {
+                format!(
+                    "{previous}Reasoning anomaly signal: {hits} of the last 5 responses used 516 tokens"
+                )
+            })
+        } else {
+            refused_line(guard, zh)
+        };
+        if let Some(warning) = warning {
+            let style = if guard.halt().is_some() || reserve {
+                Style::default()
+                    .fg(Color::Rgb(255, 241, 242))
+                    .bg(Color::Rgb(153, 27, 27))
+                    .bold()
+            } else {
+                Style::default()
+                    .fg(Color::Rgb(254, 243, 199))
+                    .bg(Color::Rgb(78, 40, 0))
+            };
+            lines.push(Line::from(format!(" {}", safe_label(&warning))).style(style));
+        }
+        Some(lines)
+    }
+
+    /// The band's tail from the first Codex release: context used and the
+    /// account's 5-hour and weekly usage, except items the user's own status
+    /// line already lists.
+    pub(in crate::chatwidget) fn model_guard_usage_parts(
+        &self,
+        listed: &[StatusLineItem],
+    ) -> Vec<String> {
+        let mut parts = Vec::new();
+        if !listed.iter().any(|item| {
+            matches!(
+                item,
+                StatusLineItem::ContextUsed | StatusLineItem::ContextRemaining
+            )
+        }) && let Some(used) = self
+            .status_line_context_used_percent()
+            .filter(|used| *used > 0)
+        {
+            parts.push(format!("ctx {used}%"));
+        }
+        if let Some(snapshot) = self.rate_limit_snapshots_by_limit_id.get("codex") {
+            for (item, window) in [
+                (
+                    StatusLineItem::FiveHourLimit,
+                    five_hour_status_window(snapshot),
+                ),
+                (StatusLineItem::WeeklyLimit, weekly_status_window(snapshot)),
+            ] {
+                if listed.contains(&item) {
+                    continue;
+                }
+                if let Some((window, secondary)) = window {
+                    let label =
+                        match limit_label_for_window(window.window_minutes, secondary).as_str() {
+                            "weekly" => "7d".to_owned(),
+                            "daily" => "1d".to_owned(),
+                            other => other.to_owned(),
+                        };
+                    let used = window.used_percent.clamp(0.0, 100.0);
+                    parts.push(format!("{label} {used:.0}% used"));
+                }
+            }
+        }
+        parts
+    }
+
+    pub(in crate::chatwidget) fn add_model_guard_details(&mut self) {
+        let Some(guard) = self.model_guard.as_ref() else {
+            return;
+        };
+        let zh = guard.settings.language == "zh";
+        let mut details: Vec<Line<'static>> = vec!["Model Guard".bold().into()];
+        let selected = safe_label(&guard.state.selected_model);
+        details.push(
+            if zh {
+                format!("已选模型: {selected}")
+            } else {
+                format!("Selected model: {selected}")
+            }
+            .into(),
+        );
+        if let Some(halt) = guard.halt() {
+            details.push(safe_label(&halt_message(halt, zh)).into());
+        }
+        if let Some(refused) = guard.refused_switch.as_ref() {
+            details.push(safe_label(&refused_switch_message(refused, zh)).into());
+        }
+        if let Some(route) = guard.route.as_ref() {
+            details.push(
+                format!(
+                    "{}: {} · {}",
+                    if zh { "最近请求" } else { "Last request" },
+                    safe_label(&route.requested_model),
+                    safe_label(route.reasoning_effort.as_deref().unwrap_or("default"))
+                )
+                .into(),
+            );
+            if let Some(actual) = route.server_model.as_ref() {
+                details.push(
+                    format!(
+                        "{}: {}",
+                        if zh {
+                            "服务端披露"
+                        } else {
+                            "Server reported"
+                        },
+                        safe_label(actual)
+                    )
+                    .into(),
+                );
+            } else {
+                details.push(
+                    if zh {
+                        "本次响应没有提供有效模型标识。"
+                    } else {
+                        "This response did not disclose an effective model."
+                    }
+                    .into(),
+                );
+            }
+            details.push(
+                match route.response_label.as_deref() {
+                    Some(label) if zh => format!("响应正文标签: {}", safe_label(label)),
+                    Some(label) => format!("Response body label: {}", safe_label(label)),
+                    None if zh => "响应正文没有模型标签。".to_owned(),
+                    None => "The response body carried no model label.".to_owned(),
+                }
+                .into(),
+            );
+        } else {
+            details.push(
+                if zh {
+                    "尚无本会话的实时路由观测。"
+                } else {
+                    "No live routing observation for this session yet."
+                }
+                .into(),
+            );
+        }
+        if let Some(tokens) = guard.last_tokens {
+            details.push(
+                format!(
+                    "{}: {tokens} tokens",
+                    if zh {
+                        "上次推理用量"
+                    } else {
+                        "Last reasoning usage"
+                    }
+                )
+                .into(),
+            );
+        }
+        let count = guard.samples.len();
+        let hits = guard.samples.iter().filter(|&&n| n == 516).count();
+        details.push(if zh {
+            format!("最近 {count} 次有效响应中，{hits} 次恰好为 516 个推理 tokens。")
+        } else {
+            format!("{hits} of the last {count} measured responses used exactly 516 reasoning tokens.")
+        }.into());
+        details.push(if zh {
+            "516 是辅助异常信号；服务端标识和用量均不能独立证明底层模型权重。"
+        } else {
+            "516 is an auxiliary signal. Server labels and usage do not attest the underlying weights."
+        }.dim().into());
+        self.add_to_history(PlainHistoryCell::new(details));
+    }
+}
+
+fn halt_line(halt: &Halt, zh: bool) -> String {
+    let stopped = if zh { "已停止" } else { "STOPPED" };
+    let resume = if zh {
+        "/model 继续"
+    } else {
+        "/model to continue"
+    };
+    let body = match halt {
+        Halt::Request {
+            selected,
+            requested,
+        } if zh => format!("请求 {requested} · 已选 {selected}"),
+        Halt::Request {
+            selected,
+            requested,
+        } => format!("request {requested} · selected {selected}"),
+        Halt::Route { requested, actual } if zh => format!("路由变化 {requested} → {actual}"),
+        Halt::Route { requested, actual } => format!("ROUTE DIFF {requested} → {actual}"),
+        Halt::Label { requested, label } if zh => format!("响应标注 {label} · 请求 {requested}"),
+        Halt::Label { requested, label } => format!("labeled {label} · requested {requested}"),
+        Halt::Reasoning { hits } if zh => format!("推理异常 {hits}/5 次 516 tokens"),
+        Halt::Reasoning { hits } => format!("reasoning anomaly {hits}/5 × 516 tokens"),
+    };
+    format!("{stopped} · {body} · {resume}")
+}
+
+fn refused_line(guard: &ModelGuard, zh: bool) -> Option<String> {
+    let (blocked, offered) = guard.refused_switch.as_ref()?;
+    Some(if zh {
+        format!("{blocked} 额度用尽 · 已拒绝自动换到 {offered} · 等待重置或 /model 换模型")
+    } else {
+        format!("usage limit on {blocked} · automatic switch to {offered} refused · wait or /model")
+    })
+}
+
+/// The history entry written when the guard holds the thread.
+pub(super) fn halt_message(halt: &Halt, zh: bool) -> String {
+    let halt = &sanitized(halt);
+    let cause = match halt {
+        Halt::Request {
+            selected,
+            requested,
+        } if zh => format!("这次请求用的是 {requested}，不是你选的 {selected}；Codex 擅自换了模型"),
+        Halt::Request {
+            selected,
+            requested,
+        } => format!(
+            "the request used {requested}, not the selected {selected}; Codex changed the model on its own"
+        ),
+        Halt::Route { requested, actual } if zh => {
+            format!("请求 {requested}，服务端披露实际用的是 {actual}")
+        }
+        Halt::Route { requested, actual } => {
+            format!("the server reported {actual} for a request to {requested}")
+        }
+        Halt::Label { requested, label } if zh => {
+            format!("请求 {requested}，响应正文标注的是 {label}（正文标签，非响应头）")
+        }
+        Halt::Label { requested, label } => format!(
+            "the response to a request for {requested} was labeled {label} (body label, not a header)"
+        ),
+        Halt::Reasoning { hits } if zh => {
+            format!("最近 5 次响应中有 {hits} 次恰好为 516 个推理 tokens（启发式信号）")
+        }
+        Halt::Reasoning { hits } => {
+            format!("{hits} of the last 5 responses used exactly 516 reasoning tokens (heuristic)")
+        }
+    };
+    let stopped = if zh {
+        "Model Guard 已停止本会话"
+    } else {
+        "Model Guard stopped this thread"
+    };
+    if zh {
+        format!("{stopped}：{cause}。在你用 /model 重新选定模型之前，不会再发出任何请求。")
+    } else {
+        format!("{stopped}: {cause}. Nothing is sent until you select a model with /model.")
+    }
+}
+
+/// The history entry written when a stopped thread refuses a new turn.
+pub(super) fn blocked_message(halt: &Halt, zh: bool) -> String {
+    let line = halt_line(&sanitized(halt), zh);
+    if zh {
+        format!("Model Guard 拦下了这条输入（{line}）。用 /model 重新选定模型后再发。")
+    } else {
+        format!(
+            "Model Guard held this input ({line}). Select a model with /model, then send it again."
+        )
+    }
+}
+
+/// The history entry written when an automatic switch is declined.
+pub(super) fn refused_switch_message((blocked, offered): &(String, String), zh: bool) -> String {
+    let (blocked, offered) = (safe_label(blocked), safe_label(offered));
+    if zh {
+        format!(
+            "{blocked} 的额度已用尽。Codex 想自动换到 {offered}，Model Guard 没有同意，模型仍是 {blocked}：在额度重置之前请求会失败，或者用 /model 自己换一个模型。"
+        )
+    } else {
+        format!(
+            "Usage limit reached for {blocked}. Codex wanted to switch to {offered} automatically; Model Guard kept {blocked}: requests fail until usage resets, or select another model with /model."
+        )
+    }
+}
+
+/// Server-written model names pass through the same filter as the footer.
+fn sanitized(halt: &Halt) -> Halt {
+    match halt {
+        Halt::Request {
+            selected,
+            requested,
+        } => Halt::Request {
+            selected: safe_label(selected),
+            requested: safe_label(requested),
+        },
+        Halt::Route { requested, actual } => Halt::Route {
+            requested: safe_label(requested),
+            actual: safe_label(actual),
+        },
+        Halt::Label { requested, label } => Halt::Label {
+            requested: safe_label(requested),
+            label: safe_label(label),
+        },
+        Halt::Reasoning { hits } => Halt::Reasoning { hits: *hits },
+    }
+}
+
+fn safe_label(value: &str) -> String {
+    value
+        .chars()
+        .filter(|c| {
+            !c.is_control() && !matches!(*c, '\u{202a}'..='\u{202e}' | '\u{2066}'..='\u{2069}')
+        })
+        .take(512)
+        .collect()
+}
