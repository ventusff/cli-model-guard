diff --git a/codex-rs/tui/src/app/model_guard.rs b/codex-rs/tui/src/app/model_guard.rs
new file mode 100644
index 00000000..3c18c3aa
--- /dev/null
+++ b/codex-rs/tui/src/app/model_guard.rs
@@ -0,0 +1,70 @@
+//! Requests to Model Guard in the process running a thread.
+//!
+//! The event loop waits for each reply, so the guard learns of a selection
+//! before any turn the loop submits afterwards, and replies reach the widget
+//! in the order the requests were made.
+
+use super::App;
+use crate::app_server_session::AppServerSession;
+use codex_app_server_protocol::ClientRequest;
+use codex_app_server_protocol::RequestId;
+use codex_app_server_protocol::ThreadModelGuardUpdateParams;
+use codex_app_server_protocol::ThreadModelGuardUpdateResponse;
+use codex_protocol::ThreadId;
+use uuid::Uuid;
+
+impl App {
+    /// The user chose `model` for the shown thread: the guard makes it the
+    /// selection and lifts the hold before the thread's settings change, so
+    /// no step of a running turn requests the model ahead of the selection.
+    pub(super) async fn select_model_for_guard(
+        &mut self,
+        app_server: &AppServerSession,
+        model: &str,
+    ) {
+        let Some(thread_id) = self.chat_widget.thread_id() else {
+            return;
+        };
+        self.chat_widget.model_guard_user_selected(model);
+        self.update_model_guard(
+            app_server,
+            thread_id,
+            Some(model.to_owned()),
+            /*reasoning_hits*/ None,
+        )
+        .await;
+    }
+
+    /// Reads the guard's state for `thread_id`, or records the user's
+    /// selection of a model or a reasoning-heuristic hold, and shows the
+    /// state the guard reports when the thread is still the one shown.
+    pub(super) async fn update_model_guard(
+        &mut self,
+        app_server: &AppServerSession,
+        thread_id: ThreadId,
+        select_model: Option<String>,
+        reasoning_hits: Option<u32>,
+    ) {
+        let result = app_server
+            .request_handle()
+            .request_typed::<ThreadModelGuardUpdateResponse>(
+                ClientRequest::ThreadModelGuardUpdate {
+                    request_id: RequestId::String(format!("model-guard-{}", Uuid::new_v4())),
+                    params: ThreadModelGuardUpdateParams {
+                        thread_id: thread_id.to_string(),
+                        select_model,
+                        reasoning_hits,
+                    },
+                },
+            )
+            .await;
+        match result {
+            Ok(response) => {
+                if self.chat_widget.thread_id() == Some(thread_id) {
+                    self.chat_widget.on_model_guard_state(response.guard);
+                }
+            }
+            Err(err) => tracing::warn!(%thread_id, "Model Guard request failed: {err}"),
+        }
+    }
+}
