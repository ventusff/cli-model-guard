diff --git a/codex-rs/tui/src/chatwidget/model_guard.rs b/codex-rs/tui/src/chatwidget/model_guard.rs
new file mode 100644
index 00000000..7ff28f5b
--- /dev/null
+++ b/codex-rs/tui/src/chatwidget/model_guard.rs
@@ -0,0 +1,678 @@
+//! Native routing and reasoning metadata for this widget's thread only.
+//!
+//! This surface participates in Codex's normal layout. It neither controls the
+//! terminal nor selects a thread from background app-server traffic.
+//!
+//! The guard also remembers the model the user selected. A sampling request
+//! for another model, an effective-model header naming another model or a
+//! response body labeled with another model stops the thread: the running
+//! turn is interrupted and no further turn is sent until the user selects a
+//! model again. Codex's own automatic model switches are declined while the
+//! guard is active, so the selected model only changes by the user's hand.
+
+use super::*;
+use codex_app_server_protocol::ModelRoutingUpdatedNotification;
+use codex_app_server_protocol::TokenUsageBreakdown;
+use std::collections::HashMap;
+use std::collections::VecDeque;
+use std::io::Read;
+use std::sync::LazyLock;
+use std::sync::Mutex;
+
+#[derive(serde::Deserialize)]
+#[serde(default)]
+pub(super) struct GuardSettings {
+    language: String,
+    show_account: bool,
+    /// Also stop on the repeated-516 reasoning heuristic. Off by default: the
+    /// count is a statistical signal, not a disclosed route.
+    halt_on_reasoning_anomaly: bool,
+}
+
+impl Default for GuardSettings {
+    fn default() -> Self {
+        Self {
+            language: "en".into(),
+            show_account: true,
+            halt_on_reasoning_anomaly: false,
+        }
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct Scope {
+    model: String,
+    provider: String,
+    effort: Option<String>,
+    tier: Option<String>,
+}
+
+/// Why the thread is stopped. A halt persists until the user selects a model.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) enum Halt {
+    /// The client requested a model other than the selected one.
+    Request { selected: String, requested: String },
+    /// The effective-model header named another model.
+    Route { requested: String, actual: String },
+    /// The response body was labeled with another model.
+    Label { requested: String, label: String },
+    /// The opt-in reasoning heuristic fired.
+    Reasoning { hits: usize },
+}
+
+impl Halt {
+    /// Disclosed causes outrank the heuristic; a request for another model
+    /// outranks everything, since the client itself changed the model.
+    fn rank(&self) -> u8 {
+        match self {
+            Halt::Request { .. } => 3,
+            Halt::Route { .. } => 2,
+            Halt::Label { .. } => 1,
+            Halt::Reasoning { .. } => 0,
+        }
+    }
+
+    fn outranks(&self, current: Option<&Halt>) -> bool {
+        current.is_none_or(|current| current.rank() < self.rank())
+    }
+}
+
+/// The stop a sampling request calls for, in rank order: the request names a
+/// model other than the selection (`review` is the one other model a review
+/// turn may use), the effective-model header names another model, or the body
+/// label belongs to another family or size tier.
+fn routing_halt(
+    selected: Option<&str>,
+    review: Option<&str>,
+    n: &ModelRoutingUpdatedNotification,
+) -> Option<Halt> {
+    let named = |candidate: Option<&str>| {
+        candidate.is_some_and(|candidate| candidate.eq_ignore_ascii_case(&n.requested_model))
+    };
+    if let Some(selected) = selected
+        && !named(Some(selected))
+        && !named(review)
+    {
+        return Some(Halt::Request {
+            selected: selected.to_owned(),
+            requested: n.requested_model.clone(),
+        });
+    }
+    if let Some(actual) = n.server_model.as_deref()
+        && !actual.eq_ignore_ascii_case(&n.requested_model)
+    {
+        return Some(Halt::Route {
+            requested: n.requested_model.clone(),
+            actual: actual.to_owned(),
+        });
+    }
+    if let Some(label) = n.response_label.as_deref()
+        && !label_consistent(&n.requested_model, label)
+    {
+        return Some(Halt::Label {
+            requested: n.requested_model.clone(),
+            label: label.to_owned(),
+        });
+    }
+    None
+}
+
+/// What this process remembers about a thread, whichever widget shows it:
+/// the model the user selected there and whether it is stopped. A stop stays
+/// in force across thread switches, side conversations and widget rebuilds.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub(crate) struct ThreadGuard {
+    pub(crate) selected: Option<String>,
+    pub(crate) halt: Option<Halt>,
+}
+
+static THREADS: LazyLock<Mutex<HashMap<ThreadId, ThreadGuard>>> = LazyLock::new(Mutex::default);
+
+pub(crate) fn thread_guard(thread: ThreadId) -> Option<ThreadGuard> {
+    THREADS.lock().ok()?.get(&thread).cloned()
+}
+
+fn remember_thread(thread: ThreadId, state: ThreadGuard) {
+    if let Ok(mut threads) = THREADS.lock() {
+        threads.insert(thread, state);
+    }
+}
+
+/// Judge a routing notification for a thread no widget is showing. A new stop
+/// is remembered for the thread and returned with the turn to interrupt.
+pub(crate) fn observe_background(
+    thread: ThreadId,
+    notification: &ServerNotification,
+) -> Option<(Halt, String)> {
+    let (halt, turn_id) = match notification {
+        ServerNotification::ModelRoutingUpdated(n) => {
+            let selected = thread_guard(thread).and_then(|state| state.selected);
+            (
+                routing_halt(selected.as_deref(), /*review*/ None, n)?,
+                n.turn_id.clone(),
+            )
+        }
+        ServerNotification::ModelRerouted(n) => (
+            Halt::Route {
+                requested: n.from_model.clone(),
+                actual: n.to_model.clone(),
+            },
+            n.turn_id.clone(),
+        ),
+        _ => return None,
+    };
+    let mut threads = THREADS.lock().ok()?;
+    let state = threads.entry(thread).or_default();
+    if !halt.outranks(state.halt.as_ref()) {
+        return None;
+    }
+    state.halt = Some(halt.clone());
+    Some((halt, turn_id))
+}
+
+#[derive(Default)]
+pub(super) struct ModelGuard {
+    settings: GuardSettings,
+    /// The model the user chose: the configured default, or the last manual selection.
+    pub(super) selected: Option<String>,
+    /// A configured review model is the only other model a request may name.
+    review: Option<String>,
+    pub(super) halt: Option<Halt>,
+    /// An automatic switch the guard declined: the blocked model and the offered one.
+    pub(super) refused_switch: Option<(String, String)>,
+    turn_id: Option<String>,
+    running: bool,
+    suspended: bool,
+    route: Option<ModelRoutingUpdatedNotification>,
+    mismatch: Option<(String, String)>,
+    label_mismatch: Option<(String, String)>,
+    scope: Option<Scope>,
+    turn_scope: Option<Scope>,
+    samples: VecDeque<i64>,
+    seen: VecDeque<String>,
+    last_tokens: Option<i64>,
+    turn_hits: usize,
+}
+
+impl ModelGuard {
+    pub(super) fn from_config(config: &Config) -> Option<Self> {
+        let effective = config.config_layer_stack.effective_config();
+        let plugins = effective.get("plugins")?.as_table()?;
+        if !config.features.enabled(Feature::Plugins)
+            || !plugins.iter().any(|(name, value)| {
+                name.split_once('@')
+                    .is_some_and(|(plugin, _)| plugin == "model-guard")
+                    && value
+                        .get("enabled")
+                        .and_then(toml::Value::as_bool)
+                        .unwrap_or(true)
+            })
+        {
+            return None;
+        }
+        let root = std::env::var_os("MODEL_GUARD_CODEX_HOME")
+            .map(PathBuf::from)
+            .or_else(|| dirs::home_dir().map(|home| home.join(".local/share/model-guard-codex")));
+        // Only this plugin's display preferences are read. Identity comes from
+        // the native account state; login files and rollouts are never inspected.
+        let settings = root
+            .and_then(|root| {
+                let file = std::fs::File::open(root.join("config.json")).ok()?;
+                serde_json::from_reader(file.take(16 * 1024)).ok()
+            })
+            .unwrap_or_default();
+        Some(Self {
+            settings,
+            selected: config.model.clone(),
+            review: config.review_model.clone(),
+            ..Self::default()
+        })
+    }
+
+    pub(super) fn language_zh(&self) -> bool {
+        self.settings.language == "zh"
+    }
+
+    /// Whether the thread may run on `model`: the selection, or the configured
+    /// review model while a review turn runs.
+    fn accepts(&self, model: &str, review_turn: bool) -> bool {
+        let named = |candidate: &Option<String>| {
+            candidate
+                .as_deref()
+                .is_some_and(|candidate| candidate.eq_ignore_ascii_case(model))
+        };
+        self.selected.is_none() || named(&self.selected) || (review_turn && named(&self.review))
+    }
+
+    fn thread_state(&self) -> ThreadGuard {
+        ThreadGuard {
+            selected: self.selected.clone(),
+            halt: self.halt.clone(),
+        }
+    }
+
+    fn start_turn(&mut self, turn_id: &str, scope: Scope) {
+        if self.turn_id.as_deref() == Some(turn_id) {
+            return;
+        }
+        self.turn_id = Some(turn_id.to_owned());
+        self.running = true;
+        self.suspended = false;
+        self.route = None;
+        self.mismatch = None;
+        self.label_mismatch = None;
+        self.turn_hits = 0;
+        if self.turn_scope.as_ref() != Some(&scope) {
+            self.scope = None;
+            self.samples.clear();
+            self.last_tokens = None;
+        }
+        self.turn_scope = Some(scope);
+    }
+
+    fn activate(&mut self, scope: Option<Scope>) {
+        if self.scope != scope {
+            self.scope = scope;
+            self.samples.clear();
+            self.last_tokens = None;
+            self.turn_hits = 0;
+        }
+    }
+
+    pub(super) fn account_changed(&mut self) {
+        self.scope = None;
+        self.samples.clear();
+        self.last_tokens = None;
+        self.turn_hits = 0;
+        self.route = None;
+        self.mismatch = None;
+        self.label_mismatch = None;
+        self.refused_switch = None;
+        // Responses already in flight can still be billed to the prior login.
+        self.suspended = self.running;
+    }
+
+    fn observe_usage(&mut self, response_id: &str, usage: Option<&TokenUsageBreakdown>) {
+        if response_id.is_empty() || self.seen.iter().any(|id| id == response_id) {
+            return;
+        }
+        self.seen.push_back(response_id.to_owned());
+        if self.seen.len() > 64 {
+            self.seen.pop_front();
+        }
+        self.last_tokens = None;
+        let Some(usage) = usage else { return };
+        let tokens = usage.reasoning_output_tokens;
+        if tokens < 0
+            || tokens > usage.output_tokens
+            || usage.output_tokens > usage.total_tokens
+            || usage.total_tokens <= 0
+        {
+            return;
+        }
+        self.last_tokens = Some(tokens);
+        self.samples.push_back(tokens);
+        if self.samples.len() > 20 {
+            self.samples.pop_front();
+        }
+        self.turn_hits += usize::from(tokens == 516);
+    }
+
+    fn recent_hits(&self) -> usize {
+        self.samples
+            .iter()
+            .rev()
+            .take(5)
+            .filter(|&&n| n == 516)
+            .count()
+    }
+
+    fn alert(&self) -> &'static str {
+        let high = self
+            .scope
+            .as_ref()
+            .and_then(|scope| scope.effort.as_deref())
+            .is_some_and(|effort| matches!(effort, "high" | "xhigh" | "max" | "ultra"));
+        if high && self.samples.len() >= 5 && self.recent_hits() >= 3 {
+            "suspect"
+        } else if high && self.turn_hits > 0 {
+            "watch"
+        } else {
+            "none"
+        }
+    }
+}
+
+impl ChatWidget {
+    fn model_guard_selected_scope(&self) -> Scope {
+        Scope {
+            model: self.current_model().to_owned(),
+            provider: self.config.model_provider_id.clone(),
+            effort: self
+                .current_reasoning_effort()
+                .map(|effort| effort.to_string()),
+            tier: self.effective_service_tier.clone(),
+        }
+    }
+
+    pub(super) fn restore_model_guard_turn(&mut self, turn: &Turn) {
+        if self.model_guard.is_none() {
+            return;
+        }
+        let scope = self.model_guard_selected_scope();
+        let mut stopped_turn_running = false;
+        if let Some(guard) = self.model_guard.as_mut() {
+            if turn.status == TurnStatus::InProgress {
+                guard.start_turn(&turn.id, scope);
+                stopped_turn_running = guard.halt.is_some();
+            } else if guard.turn_id.as_ref() == Some(&turn.id) {
+                guard.running = false;
+            }
+        }
+        if stopped_turn_running {
+            self.submit_op(AppCommand::interrupt());
+        }
+    }
+
+    fn remember_model_guard(&self) {
+        if let (Some(thread), Some(guard)) = (self.thread_id, self.model_guard.as_ref()) {
+            remember_thread(thread, guard.thread_state());
+        }
+    }
+
+    /// A replacement widget keeps the previous one's selection; the thread it
+    /// will show restores its own stop and selection once configured.
+    pub(crate) fn inherit_model_guard(&mut self, previous: &ChatWidget) {
+        if let (Some(guard), Some(inherited)) =
+            (self.model_guard.as_mut(), previous.model_guard.as_ref())
+        {
+            guard.selected = inherited.selected.clone();
+        }
+    }
+
+    /// The user chose `model`: it becomes the selection and lifts any halt.
+    pub(crate) fn model_guard_user_selected(&mut self, model: &str) {
+        let Some(guard) = self.model_guard.as_mut() else {
+            return;
+        };
+        guard.selected = Some(model.to_owned());
+        guard.halt = None;
+        guard.refused_switch = None;
+        self.remember_model_guard();
+        self.refresh_status_line();
+        self.request_redraw();
+    }
+
+    /// A configured thread adopts what this process remembers about it, then
+    /// stops before its first turn if its model is not the selection; a thread
+    /// restored on Codex's reserve model is the usual case.
+    pub(super) fn model_guard_session_configured(&mut self) {
+        let Some(thread) = self.thread_id else {
+            return;
+        };
+        let Some(guard) = self.model_guard.as_mut() else {
+            return;
+        };
+        if let Some(state) = thread_guard(thread) {
+            guard.selected = state.selected.or_else(|| guard.selected.take());
+            guard.halt = state.halt;
+        }
+        let zh = guard.language_zh();
+        let remembered = guard.halt.clone();
+        self.model_guard_check_current_model();
+        if let Some(halt) = remembered
+            && self
+                .model_guard
+                .as_ref()
+                .and_then(|guard| guard.halt.as_ref())
+                == Some(&halt)
+        {
+            self.add_error_message(display::halt_message(&halt, zh, /*interrupted*/ false));
+        }
+        self.remember_model_guard();
+    }
+
+    /// The thread's settings changed: a model other than the selection stops it.
+    pub(super) fn model_guard_settings_applied(&mut self) {
+        self.model_guard_check_current_model();
+    }
+
+    fn model_guard_check_current_model(&mut self) {
+        let model = self.current_model().to_owned();
+        let Some(guard) = self.model_guard.as_mut() else {
+            return;
+        };
+        match guard.selected.as_deref() {
+            None => {
+                guard.selected = Some(model);
+                self.remember_model_guard();
+            }
+            Some(selected) if !guard.accepts(&model, /*review_turn*/ false) => {
+                let halt = Halt::Request {
+                    selected: selected.to_owned(),
+                    requested: model,
+                };
+                self.model_guard_halt(halt);
+            }
+            Some(_) => {}
+        }
+    }
+
+    /// Codex's own switch back to the model it left for Reserve is allowed
+    /// only when that model is the selection; the stop, if any, stays.
+    pub(super) fn model_guard_allows_recovery_to(&self, model: &str) -> bool {
+        self.model_guard
+            .as_ref()
+            .is_none_or(|guard| guard.accepts(model, /*review_turn*/ false))
+    }
+
+    /// While the thread is stopped, the message that explains why input is held.
+    pub(super) fn model_guard_hold_message(&self) -> Option<String> {
+        let guard = self.model_guard.as_ref()?;
+        let halt = guard.halt.as_ref()?;
+        Some(display::blocked_message(halt, guard.language_zh()))
+    }
+
+    /// Whether `op` would start a turn on a stopped thread; the message explains why.
+    pub(crate) fn model_guard_block_message(&self, op: &AppCommand) -> Option<String> {
+        matches!(
+            op,
+            AppCommand::UserTurn { .. } | AppCommand::Review { .. } | AppCommand::Compact
+        )
+        .then(|| self.model_guard_hold_message())
+        .flatten()
+    }
+
+    /// Codex offered to switch this thread from `blocked` to `offered` on its
+    /// own. The guard keeps the selection and says so once per offer.
+    pub(super) fn model_guard_refuse_switch(&mut self, blocked: String, offered: String) {
+        let Some(guard) = self.model_guard.as_mut() else {
+            return;
+        };
+        let refused = (blocked, offered);
+        if guard.refused_switch.as_ref() == Some(&refused) {
+            return;
+        }
+        guard.refused_switch = Some(refused.clone());
+        let zh = guard.language_zh();
+        self.add_warning_message(display::refused_switch_message(&refused, zh));
+        self.refresh_status_line();
+    }
+
+    pub(super) fn model_guard_clear_refused_switch(&mut self) {
+        if let Some(guard) = self.model_guard.as_mut() {
+            guard.refused_switch = None;
+        }
+    }
+
+    fn model_guard_halt(&mut self, halt: Halt) {
+        let Some(guard) = self.model_guard.as_mut() else {
+            return;
+        };
+        let first = guard.halt.is_none();
+        if !halt.outranks(guard.halt.as_ref()) {
+            return;
+        }
+        guard.halt = Some(halt.clone());
+        let zh = guard.language_zh();
+        let running =
+            first && (self.turn_lifecycle.agent_turn_running || self.bottom_pane.is_task_running());
+        if running {
+            self.submit_op(AppCommand::interrupt());
+        }
+        self.add_error_message(display::halt_message(&halt, zh, running));
+        self.remember_model_guard();
+    }
+
+    pub(super) fn observe_model_guard(
+        &mut self,
+        notification: &ServerNotification,
+        replay_kind: Option<ReplayKind>,
+    ) {
+        if self.model_guard.is_none()
+            || !matches!(
+                notification,
+                ServerNotification::TurnStarted(_)
+                    | ServerNotification::TurnCompleted(_)
+                    | ServerNotification::ModelRoutingUpdated(_)
+                    | ServerNotification::ModelRerouted(_)
+                    | ServerNotification::RawResponseCompleted(_)
+            )
+        {
+            return;
+        }
+        if replay_kind.is_some()
+            && !matches!(
+                notification,
+                ServerNotification::TurnStarted(_) | ServerNotification::TurnCompleted(_)
+            )
+        {
+            return;
+        }
+        let Some(thread) = self.thread_id.map(|id| id.to_string()) else {
+            return;
+        };
+        let current_scope = self.model_guard_selected_scope();
+        let review_turn = self.review.is_review_mode;
+        let Some(guard) = self.model_guard.as_mut() else {
+            return;
+        };
+        let mut halt = None;
+        let mut stopped_turn_started = false;
+        match notification {
+            ServerNotification::TurnStarted(n) if n.thread_id == thread => {
+                guard.start_turn(&n.turn.id, current_scope);
+                // A stopped thread's turn can only have been started around the
+                // guard; it ends now.
+                stopped_turn_started = guard.halt.is_some();
+            }
+            ServerNotification::TurnCompleted(n)
+                if n.thread_id == thread && guard.turn_id.as_ref() == Some(&n.turn.id) =>
+            {
+                guard.running = false;
+            }
+            ServerNotification::ModelRoutingUpdated(n)
+                if n.thread_id == thread
+                    && guard.turn_id.as_ref() == Some(&n.turn_id)
+                    && guard.running =>
+            {
+                let review = review_turn.then_some(guard.review.as_deref()).flatten();
+                halt = routing_halt(guard.selected.as_deref(), review, n);
+                // Requests in flight across an account change are not shown
+                // under the new login, but they are still judged.
+                if !guard.suspended {
+                    guard.activate(Some(Scope {
+                        model: n.requested_model.clone(),
+                        provider: n.model_provider.clone(),
+                        effort: n.reasoning_effort.clone(),
+                        tier: n.service_tier.clone(),
+                    }));
+                    if let Some(actual) = n.server_model.as_ref()
+                        && !actual.eq_ignore_ascii_case(&n.requested_model)
+                    {
+                        guard.mismatch = Some((n.requested_model.clone(), actual.clone()));
+                    }
+                    if let Some(label) = n.response_label.as_deref()
+                        && !label_consistent(&n.requested_model, label)
+                    {
+                        guard.label_mismatch = Some((n.requested_model.clone(), label.to_owned()));
+                    }
+                    guard.route = Some(n.clone());
+                }
+            }
+            ServerNotification::ModelRerouted(n)
+                if n.thread_id == thread
+                    && guard.turn_id.as_ref() == Some(&n.turn_id)
+                    && guard.running =>
+            {
+                if !guard.suspended {
+                    guard.mismatch = Some((n.from_model.clone(), n.to_model.clone()));
+                }
+                halt = Some(Halt::Route {
+                    requested: n.from_model.clone(),
+                    actual: n.to_model.clone(),
+                });
+            }
+            ServerNotification::RawResponseCompleted(n)
+                if n.thread_id == thread
+                    && guard.turn_id.as_ref() == Some(&n.turn_id)
+                    && guard.running
+                    && !guard.suspended =>
+            {
+                // An attached active request may have started before this UI
+                // subscribed. Do not guess its model/effort from current settings.
+                if guard.route.is_none() {
+                    guard.activate(None);
+                }
+                guard.observe_usage(&n.response_id, n.usage.as_ref());
+                if guard.settings.halt_on_reasoning_anomaly && guard.alert() == "suspect" {
+                    halt = Some(Halt::Reasoning {
+                        hits: guard.recent_hits(),
+                    });
+                }
+            }
+            _ => return,
+        }
+        if let Some(halt) = halt {
+            self.model_guard_halt(halt);
+        }
+        if stopped_turn_started {
+            self.submit_op(AppCommand::interrupt());
+        }
+        self.refresh_status_line();
+        self.request_redraw();
+    }
+}
+
+/// Whether a response body's model label describes the requested model.
+///
+/// Equal identifiers agree, and so does one identifier extending the other
+/// at a separator (`gpt-6-astra` and `gpt-6-astra-2026-09-01`, or the bare
+/// family `gpt-6`). A size tier appended to the requested model names a
+/// different model. Everything else, including another family, differs.
+pub(super) fn label_consistent(requested: &str, label: &str) -> bool {
+    const SIZE_TIERS: [&str; 7] = ["mini", "nano", "lite", "small", "fast", "flash", "turbo"];
+    let requested = requested.to_ascii_lowercase();
+    let label = label.to_ascii_lowercase();
+    if requested == label {
+        return true;
+    }
+    let extension = |short: &str, long: &str| {
+        long.strip_prefix(short)
+            .filter(|rest| rest.starts_with(['-', '.', ':', '_', '@']))
+            .map(|rest| rest[1..].to_owned())
+    };
+    match extension(&requested, &label) {
+        Some(rest) => !rest
+            .split(['-', '.', ':', '_', '@'])
+            .any(|part| SIZE_TIERS.contains(&part)),
+        None => extension(&label, &requested).is_some(),
+    }
+}
