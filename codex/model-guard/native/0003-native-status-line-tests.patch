+const SELECTED: &str = "gpt-6-astra";
+
+fn state(hold: Option<Halt>) -> ModelGuardState {
+    ModelGuardState {
+        selected_model: SELECTED.into(),
+        hold,
+    }
+}
+
+fn guard() -> ModelGuard {
+    ModelGuard::new(state(None), GuardSettings::default())
+}
+
+fn route_hold() -> Halt {
+    Halt::Route {
+        requested: SELECTED.into(),
+        actual: "gpt-4o".into(),
+    }
+}
+
+async fn widget() -> ChatWidget {
+    let (mut chat, _sender, _events, _operations) = make_chatwidget_manual_with_sender().await;
+    chat.set_model(SELECTED);
+    chat.set_reasoning_effort(Some(ReasoningEffortConfig::Max));
+    chat.thread_id = Some(ThreadId::new());
+    chat.model_guard = Some(guard());
+    chat.observe_model_guard(&started(&chat, "turn-1"), /*replay_kind*/ None);
+    chat.observe_model_guard(&route(&chat, None), None);
+    chat
+}
+
+/// A widget whose events and ops a test reads, on a thread the guard follows.
+async fn guarded_widget() -> (
+    ChatWidget,
+    UnboundedReceiver<AppEvent>,
+    UnboundedReceiver<Op>,
+) {
+    let (mut chat, _sender, events, ops) = make_chatwidget_manual_with_sender().await;
+    chat.set_model(SELECTED);
+    chat.set_reasoning_effort(Some(ReasoningEffortConfig::Max));
+    chat.thread_id = Some(ThreadId::new());
+    chat.model_guard = Some(guard());
+    (chat, events, ops)
+}
+
+fn route(chat: &ChatWidget, actual: Option<&str>) -> ServerNotification {
+    ServerNotification::ModelRoutingUpdated(ModelRoutingUpdatedNotification {
+        thread_id: chat.thread_id.unwrap().to_string(),
+        turn_id: "turn-1".into(),
+        request_id: "request-1".into(),
+        requested_model: SELECTED.into(),
+        server_model: actual.map(str::to_owned),
+        response_label: None,
+        model_provider: "openai".into(),
+        reasoning_effort: Some("max".into()),
+        service_tier: None,
+    })
+}
+
+fn completion(chat: &ChatWidget, id: &str, tokens: i64) -> ServerNotification {
+    ServerNotification::RawResponseCompleted(RawResponseCompletedNotification {
+        thread_id: chat.thread_id.unwrap().to_string(),
+        turn_id: "turn-1".into(),
+        response_id: id.into(),
+        usage_metadata: None,
+        usage: Some(TokenUsageBreakdown {
+            input_tokens: 2000,
+            cached_input_tokens: 0,
+            cache_write_input_tokens: 0,
+            output_tokens: tokens + 10,
+            reasoning_output_tokens: tokens,
+            total_tokens: tokens + 2010,
+        }),
+    })
+}
+
+fn started(chat: &ChatWidget, turn_id: &str) -> ServerNotification {
+    ServerNotification::TurnStarted(TurnStartedNotification {
+        thread_id: chat.thread_id.unwrap().to_string(),
+        turn: Turn {
+            id: turn_id.into(),
+            root_turn_id: None,
+            items: Vec::new(),
+            items_view: Default::default(),
+            status: TurnStatus::InProgress,
+            error: None,
+            started_at: None,
+            completed_at: None,
+            duration_ms: None,
+        },
+    })
+}
+
+fn lines(chat: &ChatWidget) -> String {
+    chat.model_guard_lines()
+        .unwrap()
+        .iter()
+        .map(ToString::to_string)
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+/// The requests the widget sent to the guard: (select, reasoning hits).
+fn guard_updates(events: &mut UnboundedReceiver<AppEvent>) -> Vec<(Option<String>, Option<u32>)> {
+    std::iter::from_fn(|| events.try_recv().ok())
+        .filter_map(|event| match event {
+            AppEvent::ModelGuardUpdate {
+                select_model,
+                reasoning_hits,
+                ..
+            } => Some((select_model, reasoning_hits)),
+            _ => None,
+        })
+        .collect()
+}
+
+fn history(events: &mut UnboundedReceiver<AppEvent>) -> String {
+    std::iter::from_fn(|| events.try_recv().ok())
+        .filter_map(|event| match event {
+            AppEvent::InsertHistoryCell(cell) => Some(
+                cell.display_lines(/*width*/ 200)
+                    .iter()
+                    .map(ToString::to_string)
+                    .collect::<Vec<_>>()
+                    .join("\n"),
+            ),
+            _ => None,
+        })
+        .collect::<Vec<_>>()
+        .join("\n")
+}
