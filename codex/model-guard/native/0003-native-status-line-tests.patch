+#[tokio::test]
+async fn native_guard_reasoning_anomaly_holds_the_thread_only_when_configured() {
+    for opt_in in [false, true] {
+        let (mut chat, mut events, _ops) = guarded_widget().await;
+        chat.model_guard
+            .as_mut()
+            .unwrap()
+            .settings
+            .halt_on_reasoning_anomaly = opt_in;
+        chat.observe_model_guard(&started(&chat, "turn-1"), None);
+        chat.observe_model_guard(&route(&chat, /*actual*/ None), None);
+        for id in ["a", "b", "c", "d", "e"] {
+            chat.observe_model_guard(&completion(&chat, id, 516), None);
+        }
+        assert_eq!(chat.model_guard.as_ref().unwrap().alert(), "suspect");
+        let holds = guard_updates(&mut events)
+            .into_iter()
+            .filter_map(|(_, hits)| hits)
+            .collect::<Vec<_>>();
+        assert_eq!(
+            holds,
+            opt_in.then_some(5).into_iter().collect::<Vec<_>>(),
+            "opt_in={opt_in}"
+        );
+    }
+}
