+#[tokio::test]
+async fn native_guard_interrupts_any_turn_started_on_a_stopped_thread() {
+    let (mut chat, mut ops) = running_widget().await;
+    chat.observe_model_guard(&route(&chat, Some("gpt-4o")), /*replay_kind*/ None);
+    assert_eq!(interrupts(&mut ops), 1);
+    chat.observe_model_guard(&started(&chat, "turn-2"), /*replay_kind*/ None);
+    assert_eq!(interrupts(&mut ops), 1);
+    // A restored in-progress turn on a stopped thread ends as well.
+    let ServerNotification::TurnStarted(start) = started(&chat, "turn-3") else {
+        unreachable!()
+    };
+    chat.restore_model_guard_turn(&start.turn);
+    assert_eq!(interrupts(&mut ops), 1);
+    // A completed turn does not.
+    let ServerNotification::TurnStarted(mut done) = started(&chat, "turn-4") else {
+        unreachable!()
+    };
+    done.turn.status = TurnStatus::Completed;
+    chat.restore_model_guard_turn(&done.turn);
+    assert_eq!(interrupts(&mut ops), 0);
+}
