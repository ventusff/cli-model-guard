+#[tokio::test]
+async fn native_guard_follows_the_threads_the_guard_follows() {
+    let (mut chat, mut events, _ops) = guarded_widget().await;
+    // The same thread configured again keeps its state until the guard reports.
+    chat.model_guard_session_configured(chat.thread_id);
+    assert_eq!(guard_updates(&mut events), [(None, None)]);
+    assert!(chat.model_guard.is_some());
+    // Another thread does not show the previous thread's state.
+    chat.model_guard_session_configured(Some(ThreadId::new()));
+    assert_eq!(guard_updates(&mut events), [(None, None)]);
+    assert!(chat.model_guard_lines().is_none());
+    chat.on_model_guard_state(Some(state(None)));
+    assert!(lines(&chat).contains("selected gpt-6-astra"));
+    // The guard's notifications for this thread update it; another thread's do not.
+    let notification = |thread_id: String| {
+        ServerNotification::ThreadModelGuardUpdated(ThreadModelGuardUpdatedNotification {
+            thread_id,
+            guard: state(Some(route_hold())),
+        })
+    };
+    chat.observe_model_guard(&notification(ThreadId::new().to_string()), None);
+    assert_eq!(chat.model_guard.as_ref().unwrap().halt(), None);
+    chat.observe_model_guard(&notification(chat.thread_id.unwrap().to_string()), None);
+    assert_eq!(
+        chat.model_guard.as_ref().unwrap().halt(),
+        Some(&route_hold())
+    );
+    // A thread the guard does not follow shows and holds nothing.
+    chat.on_model_guard_state(None);
+    assert!(chat.model_guard_lines().is_none());
+    assert!(chat.model_guard_hold_message().is_none());
+}
