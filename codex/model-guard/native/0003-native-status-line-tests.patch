+    chat.observe_model_guard(&route(&chat, Some("gpt-4o")), /*replay_kind*/ None);
+    assert_eq!(interrupts(&mut ops), 1);
+    // The next widget only inherits the selection; the thread brings back its stop.
+    let (mut next, _sender, mut events, _ops) = make_chatwidget_manual_with_sender().await;
+    next.set_model("gpt-6-astra");
+    next.model_guard = Some(ModelGuard::default());
+    next.inherit_model_guard(&chat);
+    assert_eq!(
+        next.model_guard.as_ref().unwrap().selected.as_deref(),
+        Some("gpt-6-astra")
+    );
+    assert_eq!(next.model_guard.as_ref().unwrap().halt, None);
+    next.thread_id = Some(thread);
+    next.model_guard_session_configured();
+    assert_eq!(
+        next.model_guard.as_ref().unwrap().halt,
+        Some(Halt::Route {
+            requested: "gpt-6-astra".into(),
+            actual: "gpt-4o".into(),
+        })
+    );
+    assert!(lines(&next).contains("STOPPED · ROUTE DIFF gpt-6-astra → gpt-4o"));
+    assert!(next.model_guard_hold_message().is_some());
+    assert!(
+        std::iter::from_fn(|| events.try_recv().ok())
+            .any(|event| matches!(event, AppEvent::InsertHistoryCell(_)))
+    );
+    // A different thread shown by the same process starts clean.
+    let (mut other, _sender, _events, _ops) = make_chatwidget_manual_with_sender().await;
+    other.set_model("gpt-6-astra");
+    other.model_guard = Some(guard());
+    other.thread_id = Some(ThreadId::new());
