+    let (mut chat, _ops) = running_widget().await;
+    let thread = chat.thread_id.unwrap();
+    // The widget's selection is what the background check uses.
+    chat.model_guard_user_selected("gpt-6-astra");
+    let mut reserve = route(&chat, /*actual*/ None);
+    if let ServerNotification::ModelRoutingUpdated(n) = &mut reserve {
+        n.requested_model = "gpt-reserve".into();
+    }
+    assert_eq!(
+        observe_background(thread, &reserve),
+        Some((
+            Halt::Request {
+                selected: "gpt-6-astra".into(),
+                requested: "gpt-reserve".into(),
+            },
+            "turn-1".into()
+        ))
+    );
+    // The same or weaker evidence is not a second interruption.
+    assert_eq!(observe_background(thread, &reserve), None);
+    assert_eq!(
+        observe_background(thread, &route(&chat, Some("gpt-4o"))),
+        None
+    );
+    assert_eq!(
+        thread_guard(thread).unwrap().halt,
+        Some(Halt::Request {
+            selected: "gpt-6-astra".into(),
+            requested: "gpt-reserve".into(),
+        })
+    );
+    // A thread this process never selected a model for is still held to the disclosure.
+    let unknown = ThreadId::new();
+    assert_eq!(observe_background(unknown, &reserve), None);
+    let stop = observe_background(unknown, &route(&chat, Some("gpt-4o")));
+    assert!(matches!(stop, Some((Halt::Route { .. }, _))));
+    assert_eq!(
+        observe_background(unknown, &completion(&chat, "x", 516)),
+        None
+    );
+}
