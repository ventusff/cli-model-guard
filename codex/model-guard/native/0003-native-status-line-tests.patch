+#[tokio::test]
+async fn native_guard_stop_is_ordered_by_evidence_and_interrupts_once() {
+    let (mut chat, mut ops) = running_widget().await;
+    let mut labeled = route(&chat, /*actual*/ None);
+    if let ServerNotification::ModelRoutingUpdated(n) = &mut labeled {
+        n.response_label = Some("gpt-5.6-luna".into());
+    }
+    chat.observe_model_guard(&labeled, /*replay_kind*/ None);
+    assert_eq!(
+        chat.model_guard.as_ref().unwrap().halt,
+        Some(Halt::Label {
+            requested: "gpt-6-astra".into(),
+            label: "gpt-5.6-luna".into(),
+        })
+    );
+    assert_eq!(interrupts(&mut ops), 1);
+    chat.observe_model_guard(&route(&chat, Some("gpt-4o")), /*replay_kind*/ None);
+    assert_eq!(
+        chat.model_guard.as_ref().unwrap().halt,
+        Some(Halt::Route {
+            requested: "gpt-6-astra".into(),
+            actual: "gpt-4o".into(),
+        })
+    );
+    assert_eq!(interrupts(&mut ops), 0);
+    // Weaker evidence never replaces the disclosed route.
+    chat.observe_model_guard(&labeled, /*replay_kind*/ None);
+    assert!(matches!(
+        chat.model_guard.as_ref().unwrap().halt,
+        Some(Halt::Route { .. })
+    ));
+    let mut rerouted = route(&chat, /*actual*/ None);
+    if let ServerNotification::ModelRoutingUpdated(n) = &mut rerouted {
+        n.requested_model = "gpt-reserve".into();
+    }
+    chat.observe_model_guard(&rerouted, /*replay_kind*/ None);
+    assert!(matches!(
+        chat.model_guard.as_ref().unwrap().halt,
+        Some(Halt::Request { .. })
+    ));
+    assert_eq!(interrupts(&mut ops), 0);
+}
