+#[tokio::test]
+async fn native_guard_declines_codex_automatic_model_switches() {
+    let (mut chat, _sender, _events, _ops) = make_chatwidget_manual_with_sender().await;
+    chat.set_model("test-model-a");
+    chat.has_chatgpt_account = true;
+    chat.requires_openai_auth = true;
+    chat.thread_id = Some(ThreadId::new());
+    let template = chat.model_catalog.try_list_models().unwrap()[0].clone();
+    let models = ["test-model-b", "gpt-reserve"].map(|model| ModelPreset {
+        model: model.into(),
+        show_in_picker: model != "gpt-reserve",
+        ..template.clone()
+    });
+    chat.model_catalog = Arc::new(ModelCatalog::new(models.to_vec()));
+    let selected = |refused_switch| {
+        let mut guard = ModelGuard::new(
+            ModelGuardState {
+                selected_model: "test-model-a".into(),
+                hold: None,
+            },
+            GuardSettings::default(),
+        );
+        guard.refused_switch = refused_switch;
+        guard
+    };
+    chat.model_guard = Some(selected(None));
+    // A blocked model with fallback candidates.
+    chat.update_backend_banner(&usage_limit_response(serde_json::json!({
+        "banner_type": "selected_model_limit", "blocked_model_slug": "test-model-a",
+        "fallback_model_slugs": ["test-model-b"], "presentation": "inline",
+        "title": "Selected model usage exhausted", "description": "Switch.", "ctas": [],
+    })));
+    assert_eq!(chat.backend_banner_fallback(), None);
+    assert_eq!(
+        chat.model_guard.as_ref().unwrap().refused_switch,
+        Some(("test-model-a".into(), "test-model-b".into()))
+    );
+    assert_eq!(chat.current_model(), "test-model-a");
+    assert!(lines(&chat).contains("automatic switch to test-model-b refused"));
+    // The Reserve banner: no switch, no held input, no Reserve-only picker.
+    chat.update_backend_banner(&usage_limit_response(serde_json::json!({
+        "banner_type": "luna_reserve", "presentation": "dismissible",
+        "title": "You’re now using Luna", "description": "Add credits.", "ctas": [],
+    })));
+    assert_eq!(chat.backend_banner_fallback(), None);
+    assert_eq!(
+        chat.model_guard.as_ref().unwrap().refused_switch,
+        Some(("test-model-a".into(), "gpt-reserve".into()))
+    );
+    assert!(!chat.waiting_for_luna_reserve());
+    assert!(!chat.input_queue.rate_limit_recovery_pending);
+    chat.set_model("gpt-reserve");
+    assert!(!chat.restrict_model_picker_to_luna_reserve());
+    chat.set_model("test-model-a");
+    // The same offers switch the thread when the guard does not follow it.
+    chat.model_guard = None;
+    assert_eq!(
+        chat.backend_banner_fallback()
+            .map(|switch| switch.model.model),
+        Some("gpt-reserve".into())
+    );
+    assert!(chat.waiting_for_luna_reserve());
+    // Recovered usage ends the refusal.
+    chat.model_guard = Some(selected(Some((
+        "test-model-a".into(),
+        "gpt-reserve".into(),
+    ))));
+    chat.update_backend_banner(
+        &serde_json::from_value(serde_json::json!({
+            "accountId": "account-a", "ordinaryUsageAllowed": true, "rateLimits": {},
+        }))
+        .unwrap(),
+    );
+    assert_eq!(chat.model_guard.as_ref().unwrap().refused_switch, None);
+}
+
+#[tokio::test]
+async fn native_guard_recovery_only_returns_to_the_selection_and_keeps_the_hold() {
+    let (mut chat, _events, _ops) = guarded_widget().await;
+    chat.on_model_guard_state(Some(state(Some(Halt::Request {
+        selected: SELECTED.into(),
+        requested: "gpt-reserve".into(),
+    }))));
+    chat.set_model("gpt-reserve");
+    assert!(chat.model_guard_allows_recovery_to(SELECTED));
+    assert!(!chat.model_guard_allows_recovery_to("gpt-6-sol"));
+    let mut mode = chat.effective_collaboration_mode();
+    mode.settings.model = SELECTED.into();
+    chat.finish_backend_banner_fallback(mode);
+    assert_eq!(chat.current_model(), SELECTED);
+    assert!(
+        chat.model_guard.as_ref().unwrap().halt().is_some(),
+        "Codex's own recovery never lifts a hold"
+    );
+    chat.model_guard = None;
+    assert!(chat.model_guard_allows_recovery_to("gpt-6-sol"));
+}
+
+#[tokio::test]
+async fn native_guard_footer_keeps_the_account_email_read_after_an_update() {
+    let (mut chat, _events, _ops) = guarded_widget().await;
+    chat.update_account_state(
+        Some(StatusAccountDisplay::ChatGpt {
+            email: None,
+            plan: Some("Pro".into()),
+        }),
+        /*plan_type*/ None,
+        /*has_chatgpt_account*/ true,
+        /*has_codex_backend_auth*/ true,
+    );
+    assert!(!lines(&chat).contains("@"));
+    chat.on_account_email_loaded(Some("someone@example.com".into()));
+    assert!(lines(&chat).contains("selected gpt-6-astra · max · someone@example.com · Pro"));
+    // An API-key display has no email to take.
+    chat.update_account_state(
+        Some(StatusAccountDisplay::ApiKey),
+        /*plan_type*/ None,
+        /*has_chatgpt_account*/ false,
+        /*has_codex_backend_auth*/ false,
+    );
+    chat.on_account_email_loaded(Some("someone@example.com".into()));
+    assert!(lines(&chat).contains("API key"));
+    assert!(!lines(&chat).contains("@example"));
+}
+
+#[tokio::test]
+async fn native_guard_footer_carries_usage_unless_the_status_line_lists_it() {
+    let (mut chat, _events, _ops) = guarded_widget().await;
+    assert!(chat.model_guard_usage_parts(&[]).is_empty());
+    chat.on_rate_limit_snapshot(Some(RateLimitSnapshot {
+        primary: Some(RateLimitWindow {
+            used_percent: 42,
+            window_duration_mins: Some(300),
+            resets_at: None,
+        }),
+        secondary: Some(RateLimitWindow {
+            used_percent: 21,
+            window_duration_mins: Some(10080),
+            resets_at: None,
+        }),
+        limit_id: None,
+        limit_name: None,
+        normal_model_slug: None,
+        credits: None,
+        individual_limit: None,
+        spend_control_reached: None,
+        plan_type: None,
+        rate_limit_reached_type: None,
+    }));
+    assert_eq!(
+        chat.model_guard_usage_parts(&[]),
+        vec!["5h 42% used".to_string(), "7d 21% used".to_string()]
+    );
+    assert_eq!(
+        chat.model_guard_usage_parts(&[StatusLineItem::WeeklyLimit]),
+        vec!["5h 42% used".to_string()]
+    );
+    chat.refresh_status_line();
+    let footer = lines(&chat);
+    assert!(footer.contains("selected gpt-6-astra"), "{footer}");
+}
