+#[tokio::test]
+async fn native_guard_declines_codex_automatic_model_switches() {
+    let (mut chat, _sender, _events, _ops) = make_chatwidget_manual_with_sender().await;
+    chat.set_model("test-model-a");
+    chat.has_chatgpt_account = true;
+    chat.requires_openai_auth = true;
+    chat.thread_id = Some(ThreadId::new());
+    let template = chat.model_catalog.try_list_models().unwrap()[0].clone();
+    let models = ["test-model-b", "gpt-reserve"].map(|model| ModelPreset {
+        model: model.into(),
+        show_in_picker: model != "gpt-reserve",
+        ..template.clone()
+    });
+    chat.model_catalog = Arc::new(ModelCatalog::new(models.to_vec()));
+    chat.model_guard = Some(ModelGuard {
+        selected: Some("test-model-a".into()),
+        ..ModelGuard::default()
+    });
+    // A blocked model with fallback candidates.
+    chat.update_backend_banner(&usage_limit_response(serde_json::json!({
+        "banner_type": "selected_model_limit", "blocked_model_slug": "test-model-a",
+        "fallback_model_slugs": ["test-model-b"], "presentation": "inline",
+        "title": "Selected model usage exhausted", "description": "Switch.", "ctas": [],
+    })));
+    assert_eq!(chat.backend_banner_fallback(), None);
+    assert_eq!(
+        chat.model_guard.as_ref().unwrap().refused_switch,
+        Some(("test-model-a".into(), "test-model-b".into()))
+    );
+    assert_eq!(chat.current_model(), "test-model-a");
+    assert!(lines(&chat).contains("automatic switch to test-model-b refused"));
+    // The Reserve banner: no switch, no held input, no Reserve-only picker.
+    chat.update_backend_banner(&usage_limit_response(serde_json::json!({
+        "banner_type": "luna_reserve", "presentation": "dismissible",
+        "title": "You’re now using Luna", "description": "Add credits.", "ctas": [],
+    })));
+    assert_eq!(chat.backend_banner_fallback(), None);
+    assert_eq!(
+        chat.model_guard.as_ref().unwrap().refused_switch,
+        Some(("test-model-a".into(), "gpt-reserve".into()))
+    );
+    assert!(!chat.waiting_for_luna_reserve());
+    assert!(!chat.input_queue.rate_limit_recovery_pending);
+    chat.set_model("gpt-reserve");
+    assert!(!chat.restrict_model_picker_to_luna_reserve());
+    chat.set_model("test-model-a");
+    // The same offers switch the thread as soon as the guard is absent.
+    chat.model_guard = None;
+    assert_eq!(
+        chat.backend_banner_fallback()
+            .map(|switch| switch.model.model),
+        Some("gpt-reserve".into())
+    );
+    assert!(chat.waiting_for_luna_reserve());
+    // Recovered usage ends the refusal.
+    chat.model_guard = Some(ModelGuard {
+        selected: Some("test-model-a".into()),
+        refused_switch: Some(("test-model-a".into(), "gpt-reserve".into())),
+        ..ModelGuard::default()
+    });
+    chat.update_backend_banner(
+        &serde_json::from_value(serde_json::json!({
+            "accountId": "account-a", "ordinaryUsageAllowed": true, "rateLimits": {},
+        }))
+        .unwrap(),
+    );
+    assert_eq!(chat.model_guard.as_ref().unwrap().refused_switch, None);
+}
