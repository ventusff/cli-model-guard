+#[tokio::test]
+async fn native_guard_shows_and_holds_what_the_guard_reports() {
+    let (mut chat, mut events, mut ops) = guarded_widget().await;
+    chat.on_model_guard_state(Some(state(Some(Halt::Request {
+        selected: SELECTED.into(),
+        requested: "gpt-reserve".into(),
+    }))));
+    insta::assert_snapshot!(lines(&chat), @r"
+     selected gpt-6-astra · max
+     STOPPED · request gpt-reserve · selected gpt-6-astra · /model to continue
+    ");
+    // A hold outside a running turn is written to the history.
+    assert!(history(&mut events).contains("Model Guard stopped this thread"));
+    // Input that would start a turn stays in the composer; ending a turn does not.
+    assert!(chat.model_guard_block_message(&Op::Compact).is_some());
+    assert!(chat.model_guard_block_message(&Op::interrupt()).is_none());
+    chat.submit_user_message(UserMessage::from("hello"));
+    assert_eq!(chat.bottom_pane.composer_text(), "hello");
+    assert!(
+        !std::iter::from_fn(|| ops.try_recv().ok()).any(|op| matches!(op, Op::UserTurn { .. }))
+    );
+}
