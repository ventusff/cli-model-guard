+fn interrupts(ops: &mut tokio::sync::mpsc::UnboundedReceiver<Op>) -> usize {
+    std::iter::from_fn(|| ops.try_recv().ok())
+        .filter(|op| matches!(op, Op::Interrupt))
+        .count()
+}
