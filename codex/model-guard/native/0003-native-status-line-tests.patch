+async fn running_widget() -> (ChatWidget, tokio::sync::mpsc::UnboundedReceiver<Op>) {
+    let (mut chat, _sender, _events, ops) = make_chatwidget_manual_with_sender().await;
+    chat.set_model("gpt-6-astra");
+    chat.set_reasoning_effort(Some(ReasoningEffortConfig::Max));
+    chat.thread_id = Some(ThreadId::new());
+    chat.model_guard = Some(guard());
+    chat.observe_model_guard(&started(&chat, "turn-1"), /*replay_kind*/ None);
+    chat.bottom_pane.set_task_running(/*running*/ true);
+    (chat, ops)
