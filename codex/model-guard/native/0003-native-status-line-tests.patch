+#[tokio::test]
+async fn native_guard_request_for_another_model_stops_the_turn_until_the_user_selects() {
+    let (mut chat, mut ops) = running_widget().await;
+    let mut reserve = route(&chat, /*actual*/ None);
+    if let ServerNotification::ModelRoutingUpdated(n) = &mut reserve {
+        n.requested_model = "gpt-reserve".into();
+        n.response_label = Some("gpt-reserve".into());
+    }
+    chat.observe_model_guard(&reserve, /*replay_kind*/ None);
+    let guard = chat.model_guard.as_ref().unwrap();
+    assert_eq!(
+        guard.halt,
+        Some(Halt::Request {
+            selected: "gpt-6-astra".into(),
+            requested: "gpt-reserve".into(),
+        })
+    );
+    assert_eq!(interrupts(&mut ops), 1);
+    insta::assert_snapshot!(lines(&chat), @r"
+     request gpt-reserve · max
+     STOPPED · request gpt-reserve · selected gpt-6-astra · /model to continue
+    ");
+    assert!(chat.model_guard_hold_message().is_some());
+    assert!(chat.model_guard_block_message(&Op::Compact).is_some());
+    assert!(chat.model_guard_block_message(&Op::interrupt()).is_none());
+    // A second observation of the same request does not interrupt again.
+    chat.observe_model_guard(&reserve, /*replay_kind*/ None);
+    assert_eq!(interrupts(&mut ops), 0);
+    // Selecting a model, even the same one, is the only way out.
+    chat.model_guard_user_selected("gpt-6-astra");
+    let guard = chat.model_guard.as_ref().unwrap();
+    assert_eq!(
+        (guard.halt.as_ref(), guard.selected.as_deref()),
+        (None, Some("gpt-6-astra"))
+    );
+    assert!(chat.model_guard_hold_message().is_none());
+}
