+#[tokio::test]
+async fn native_guard_layout_preserves_composer_cursor_at_multiple_widths() {
+    let mut chat = widget().await;
+    chat.on_model_guard_state(Some(state(Some(route_hold()))));
+    for width in [40, 80, 140] {
+        let height = chat.desired_height(width);
+        let area = Rect::new(/*x*/ 0, /*y*/ 0, width, height);
+        let cursor = chat.cursor_pos(area);
+        let mut buf = Buffer::empty(area);
+        chat.render(area, &mut buf);
+        let guard = chat.model_guard.take();
+        let stock_height = chat.desired_height(width);
+        let stock_cursor =
+            chat.cursor_pos(Rect::new(/*x*/ 0, /*y*/ 0, width, stock_height));
+        let warning_rows = if width == 40 { 2 } else { 1 };
+        assert_eq!(
+            (height, cursor),
+            (stock_height + warning_rows, stock_cursor)
+        );
+        chat.model_guard = guard;
+        insta::assert_snapshot!(
+            format!("native_guard_width_{width}"),
+            buf.content
+                .chunks(usize::from(width))
+                .map(|row| row
+                    .iter()
+                    .map(ratatui::buffer::Cell::symbol)
+                    .collect::<String>()
+                    .trim_end()
+                    .to_owned())
+                .collect::<Vec<_>>()
+                .join("\n")
+        );
+    }
+}
