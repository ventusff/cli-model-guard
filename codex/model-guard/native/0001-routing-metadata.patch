--- /dev/null
+++ b/codex-rs/core/tests/suite/model_routing.rs
@@ -0,0 +1,93 @@
+//! Routing disclosures are metadata, not a model identity attestation.
+use anyhow::Result;
+use codex_core::TurnInputRequest;
+use codex_protocol::openai_models::ReasoningEffort;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::user_input::UserInput;
+use core_test_support::responses::ev_completed;
+use core_test_support::responses::mount_response_once;
+use core_test_support::responses::sse;
+use core_test_support::responses::sse_response;
+use core_test_support::responses::start_mock_server;
+use core_test_support::test_codex::test_codex;
+use core_test_support::wait_for_event;
+use pretty_assertions::assert_eq;
+use test_case::test_case;
+
+#[test_case(None, ReasoningEffort::Max; "missing disclosure stays unverified even with a body model")]
+#[test_case(Some("gpt-6-astra"), ReasoningEffort::Max; "matching header is disclosed")]
+#[test_case(Some("gpt-4o"), ReasoningEffort::Max; "different header is disclosed")]
+#[test_case(None, ReasoningEffort::Ultra; "ultra metadata follows the wire request")]
+#[test_case(None, ReasoningEffort::Persistent; "persistent metadata follows the wire request")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn model_routing_reports_only_effective_transport_metadata(
+    header: Option<&str>,
+    effort: ReasoningEffort,
+) -> Result<()> {
+    let server = start_mock_server().await;
+    let body = sse(vec![
+        serde_json::json!({"type":"response.created", "response":{"id":"routing-response", "model":"gpt-4o"}}),
+        ev_completed("routing-response"),
+    ]);
+    let response = match header {
+        Some(header) => sse_response(body).insert_header("OpenAI-Model", header),
+        None => sse_response(body),
+    };
+    let mock = mount_response_once(&server, response).await;
+    let mut builder = test_codex()
+        .with_model("gpt-6-astra")
+        .with_config(move |config| {
+            config.model_reasoning_effort = Some(effort);
+            config.service_tier = Some("default".into());
+        });
+    let test = builder.build_with_auto_env(&server).await?;
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "Reply OK without tools.".into(),
+            text_elements: Vec::new(),
+        }]))
+        .await?;
+    let mut routing = Vec::new();
+    loop {
+        match wait_for_event(&test.codex, |_| true).await {
+            EventMsg::ModelRouting(metadata) => routing.push(metadata),
+            EventMsg::TurnComplete(_) => break,
+            _ => {}
+        }
+    }
+    let first = routing.first().expect("sampling request metadata");
+    assert_eq!(
+        (&first.requested_model, first.server_model.as_ref()),
+        (&"gpt-6-astra".to_string(), None)
+    );
+    assert!(!first.request_id.is_empty());
+    // The body label is reported on its own; it never becomes the server model.
+    let mut expected = vec![(None, None)];
+    if let Some(header) = header {
+        expected.push((Some(header.to_string()), None));
+    }
+    expected.push((header.map(str::to_string), Some("gpt-4o".to_string())));
+    assert_eq!(
+        routing
+            .iter()
+            .map(|r| (r.server_model.clone(), r.response_label.clone()))
+            .collect::<Vec<_>>(),
+        expected
+    );
+    assert!(routing.iter().all(|r| r.request_id == first.request_id));
+    let request = mock.single_request().body_json();
+    assert_eq!(
+        first.requested_model,
+        request["model"].as_str().expect("request model")
+    );
+    assert_eq!(
+        first.reasoning_effort.as_deref(),
+        request["reasoning"]["effort"].as_str()
+    );
+    assert_eq!(
+        first.service_tier.as_deref(),
+        request["service_tier"].as_str()
+    );
+    assert_eq!(first.service_tier, None);
+    Ok(())
+}
