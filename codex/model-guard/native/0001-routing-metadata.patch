@@ -0,0 +1,108 @@
+//! Routing of each model request: Model Guard admits it, the thread learns
+//! which model it named and what the response disclosed about the model that
+//! served it, and a disclosure of another model ends the response.
+use super::*;
+use crate::model_guard;
+use codex_protocol::protocol::ModelRoutingEvent;
+
+/// One admitted model request of a thread's turn, followed while its
+/// response streams.
+pub(super) struct RequestRouting {
+    thread: ThreadId,
+    turn_id: String,
+    sender: Sender<ProtocolEvent>,
+    event: ModelRoutingEvent,
+}
+
+impl ModelClient {
+    /// Admits a request about to be sent and announces its routing. Model
+    /// Guard refuses a request on a held thread or for a model other than the
+    /// selection; nothing is sent then. Requests outside a turn of a thread
+    /// with a provider carry no routing.
+    pub(super) async fn begin_model_request(
+        &self,
+        request: &ResponsesApiRequest,
+        metadata: &CodexResponsesMetadata,
+    ) -> Result<Option<RequestRouting>> {
+        let (Some(turn_id), Some(model_provider), Some(sender)) = (
+            metadata.turn_id.as_ref(),
+            self.model_provider_id.as_ref(),
+            self.event_sender.as_ref(),
+        ) else {
+            return Ok(None);
+        };
+        let thread = self.state.thread_id;
+        if let Err(refusal) = model_guard::admit(thread, &request.model) {
+            if refusal.changed {
+                announce(sender, turn_id, EventMsg::ModelGuard(refusal.state.clone())).await;
+            }
+            return Err(refusal.into_error());
+        }
+        let event = ModelRoutingEvent {
+            request_id: Uuid::new_v4().to_string(),
+            requested_model: request.model.clone(),
+            server_model: None,
+            response_label: None,
+            model_provider: model_provider.clone(),
+            reasoning_effort: request
+                .reasoning
+                .as_ref()
+                .and_then(|reasoning| reasoning.effort.as_ref())
+                .map(ToString::to_string),
+            service_tier: request.service_tier.clone(),
+        };
+        // Invalidate the previous disclosure before network I/O, including a
+        // transport retry. No request body, credentials or response text is sent.
+        announce(sender, turn_id, EventMsg::ModelRouting(event.clone())).await;
+        Ok(Some(RequestRouting {
+            thread,
+            turn_id: turn_id.clone(),
+            sender: sender.clone(),
+            event,
+        }))
+    }
+}
+
+impl RequestRouting {
+    /// Records what a response event disclosed about the model that served
+    /// the request: the effective-model header or the body's model label. A
+    /// disclosure of another model holds the thread and ends the response.
+    pub(super) async fn observe(&mut self, event: &ResponseEvent) -> Result<()> {
+        let (slot, value) = match event {
+            ResponseEvent::ServerModel(model) => (&mut self.event.server_model, model),
+            ResponseEvent::ResponseModelLabel(label) => (&mut self.event.response_label, label),
+            _ => return Ok(()),
+        };
+        if slot.as_deref() == Some(value.as_str()) {
+            return Ok(());
+        }
+        *slot = Some(value.clone());
+        self.announce(EventMsg::ModelRouting(self.event.clone()))
+            .await;
+        let Some((state, changed)) = model_guard::observe(
+            self.thread,
+            &self.event.requested_model,
+            self.event.server_model.as_deref(),
+            self.event.response_label.as_deref(),
+        ) else {
+            return Ok(());
+        };
+        if changed {
+            self.announce(EventMsg::ModelGuard(state.clone())).await;
+        }
+        Err(model_guard::held_error(&state))
+    }
+
+    async fn announce(&self, msg: EventMsg) {
+        announce(&self.sender, &self.turn_id, msg).await;
+    }
+}
+
+async fn announce(sender: &Sender<ProtocolEvent>, turn_id: &str, msg: EventMsg) {
+    let _ = sender
+        .send(ProtocolEvent {
+            id: turn_id.to_owned(),
+            msg,
+        })
+        .await;
+}
