+    /// Reads Model Guard's state for a thread, records the user's selection
+    /// of a model, or holds the thread for the client's reasoning heuristic,
+    /// and names this process's Model Guard release. A change is announced to
+    /// every client, as the guard's own changes are.
+    pub(crate) async fn thread_model_guard_update(
+        &self,
+        params: codex_app_server_protocol::ThreadModelGuardUpdateParams,
+    ) -> Result<Option<ClientResponsePayload>, JSONRPCErrorError> {
+        let thread = ThreadId::from_string(&params.thread_id)
+            .map_err(|err| invalid_request(format!("invalid thread id: {err}")))?;
+        let (state, changes) = match (params.select_model, params.reasoning_hits) {
+            (Some(model), _) => (codex_core::model_guard::select(thread, &model), true),
+            (None, Some(hits)) => (
+                codex_core::model_guard::hold_for_reasoning(thread, hits),
+                true,
+            ),
+            (None, None) => (codex_core::model_guard::state(thread), false),
+        };
+        let guard = state.map(codex_app_server_protocol::ModelGuardState::from);
+        if changes && let Some(guard) = guard.clone() {
+            self.outgoing
+                .send_server_notification(ServerNotification::ThreadModelGuardUpdated(
+                    codex_app_server_protocol::ThreadModelGuardUpdatedNotification {
+                        thread_id: params.thread_id,
+                        guard,
+                    },
+                ))
+                .await;
+        }
+        let response = codex_app_server_protocol::ThreadModelGuardUpdateResponse {
+            guard,
+            version: codex_app_server_protocol::MODEL_GUARD_VERSION.to_string(),
+        };
+        Ok(Some(response.into()))
+    }
