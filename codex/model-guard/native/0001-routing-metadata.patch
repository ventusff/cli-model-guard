+/// Metadata for one sampling request. A missing server model is unverified.
+///
+/// `server_model` only comes from the transport's effective-model disclosure,
+/// never from response text or the requested model. `response_label` is the
+/// `model` field of the response body: a server-written label that is kept
+/// separate because it can differ from the effective-model header.
+#[derive(Debug, Clone, Deserialize, Serialize, PartialEq, Eq, JsonSchema, TS)]
+pub struct ModelRoutingEvent {
+    pub request_id: String,
+    pub requested_model: String,
+    pub server_model: Option<String>,
+    pub response_label: Option<String>,
+    pub model_provider: String,
+    pub reasoning_effort: Option<String>,
+    pub service_tier: Option<String>,
+}
+
+/// Model Guard's state for a thread. `selected_model` is the model the user
+/// selected; while `hold` is set, the thread sends no model request.
+#[derive(Debug, Clone, Deserialize, Serialize, PartialEq, Eq, JsonSchema, TS)]
+pub struct ModelGuardEvent {
+    pub selected_model: String,
+    pub hold: Option<ModelGuardHold>,
+}
+
+/// Why Model Guard holds a thread, in rank order: a request for a model other
+/// than the selection, an effective-model header naming another model, a
+/// response body labeled with another model, the opt-in reasoning heuristic.
+#[derive(Debug, Clone, Deserialize, Serialize, PartialEq, Eq, JsonSchema, TS)]
+#[serde(tag = "type", rename_all = "snake_case")]
+#[ts(tag = "type", rename_all = "snake_case")]
+pub enum ModelGuardHold {
+    Request { selected: String, requested: String },
+    Route { requested: String, actual: String },
+    Label { requested: String, label: String },
+    Reasoning { hits: u32 },
+}
+
 #[derive(Debug, Clone, Copy, Deserialize, Serialize, PartialEq, Eq, JsonSchema, TS)]
 #[serde(rename_all = "snake_case")]
 #[ts(rename_all = "snake_case")]
