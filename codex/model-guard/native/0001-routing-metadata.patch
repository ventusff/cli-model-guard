new file mode 100644
index 00000000..6dc426af
--- /dev/null
+++ b/codex-rs/core/src/model_guard.rs
@@ -0,0 +1,415 @@
+//! Model Guard keeps every thread it follows on the model the user selected.
+//!
+//! Each followed thread has a selection and, when something went wrong, a
+//! hold. Two points decide everything: a model request is admitted only on a
+//! thread that is not held and only for the selected model, and a response
+//! that discloses another model (an effective-model header, or a body label
+//! of another family or size tier) holds the thread and ends the response.
+//! Every model request of a thread passes both points, whoever started its
+//! turn, so a held thread does no model work at all until the user selects a
+//! model again. A refused request ends its turn with a terminal error.
+//!
+//! A thread Codex runs on another thread's behalf (a sub-agent, a review, an
+//! approval review) is held while any thread it runs for is held. The user's
+//! selection on a thread releases every thread run on its behalf as well,
+//! since some of them (an approval review) offer no selection of their own.
+//!
+//! The registry lives as long as the process that hosts the threads, so a
+//! thread keeps its selection and its hold across the clients attached to it.
+
+use std::collections::HashMap;
+use std::sync::LazyLock;
+use std::sync::Mutex;
+
+use codex_features::Feature;
+use codex_protocol::ThreadId;
+use codex_protocol::error::CodexErr;
+use codex_protocol::protocol::ModelGuardEvent;
+use codex_protocol::protocol::ModelGuardHold;
+
+use crate::config::Config;
+
+type Threads = HashMap<ThreadId, Followed>;
+
+static THREADS: LazyLock<Mutex<Threads>> = LazyLock::new(Mutex::default);
+
+/// A followed thread: its own selection and hold, and the thread it runs on
+/// behalf of, whose hold holds it as well.
+struct Followed {
+    state: ModelGuardEvent,
+    runs_for: Option<ThreadId>,
+}
+
+/// Whether the Model Guard plugin is enabled in `config`.
+pub fn enabled(config: &Config) -> bool {
+    let effective_config = config.config_layer_stack.effective_config();
+    config.features.enabled(Feature::Plugins)
+        && effective_config
+            .get("plugins")
+            .and_then(toml::Value::as_table)
+            .is_some_and(|plugins| {
+                plugins.iter().any(|(name, value)| {
+                    name.split_once('@')
+                        .is_some_and(|(plugin, _)| plugin == "model-guard")
+                        && value
+                            .get("enabled")
+                            .and_then(toml::Value::as_bool)
+                            .unwrap_or(true)
+                })
+            })
+}
+
+/// The model the user configured: the `model` of the configuration layers
+/// (config files, the selected profile, command-line `-c`). A resumed thread
+/// carries its last model in `config.model`; that one is the thread's, not
+/// the user's choice.
+pub(crate) fn configured_model(config: &Config) -> Option<String> {
+    config
+        .config_layer_stack
+        .effective_config()
+        .get("model")
+        .and_then(toml::Value::as_str)
+        .map(str::to_owned)
+}
+
+/// How a thread came to exist, which decides its selection when the guard
+/// first follows it.
+pub(crate) enum Origin {
+    /// A thread the user started or resumed: its selection is the configured
+    /// model, so a thread restored on another model is held at once.
+    User { configured: Option<String> },
+    /// A new fork of a thread carries that thread's selection and hold.
+    Fork {
+        parent: ThreadId,
+        configured: Option<String>,
+    },
+    /// A thread Codex runs on a thread's behalf (a sub-agent, a review, an
+    /// approval review) uses the model it was configured with and is held
+    /// while its parent is held.
+    Child { parent: ThreadId },
+}
+
+/// Starts following `thread`, which runs on `model`, unless the guard
+/// already follows it. Returns the thread's state.
+pub(crate) fn follow(thread: ThreadId, origin: Origin, model: &str) -> ModelGuardEvent {
+    let mut threads = lock();
+    if let Some(followed) = threads.get(&thread) {
+        return effective(&threads, followed);
+    }
+    let followed = match origin {
+        Origin::User { configured } => Followed {
+            state: held_unless_selected(configured, model),
+            runs_for: None,
+        },
+        Origin::Fork { parent, configured } => Followed {
+            state: effective_of(&threads, parent)
+                .unwrap_or_else(|| held_unless_selected(configured, model)),
+            runs_for: None,
+        },
+        Origin::Child { parent } => Followed {
+            state: ModelGuardEvent {
+                selected_model: model.to_owned(),
+                hold: None,
+            },
+            runs_for: Some(parent),
+        },
+    };
+    let state = effective(&threads, &followed);
+    threads.insert(thread, followed);
+    state
+}
+
+fn held_unless_selected(configured: Option<String>, model: &str) -> ModelGuardEvent {
+    let selected_model = configured.unwrap_or_else(|| model.to_owned());
+    let hold = (!same_model(&selected_model, model)).then(|| ModelGuardHold::Request {
+        selected: selected_model.clone(),
+        requested: model.to_owned(),
+    });
+    ModelGuardEvent {
+        selected_model,
+        hold,
+    }
+}
+
+/// A thread's selection, and its own hold or else the hold of the nearest
+/// thread it runs on behalf of.
+fn effective(threads: &Threads, followed: &Followed) -> ModelGuardEvent {
+    let mut state = followed.state.clone();
+    let mut runs_for = followed.runs_for;
+    // Each step goes to another followed thread, so the walk ends within the
+    // registry's size even on a malformed chain.
+    for _ in 0..threads.len() {
+        if state.hold.is_some() {
+            break;
+        }
+        let Some(parent) = runs_for.and_then(|parent| threads.get(&parent)) else {
+            break;
+        };
+        state.hold.clone_from(&parent.state.hold);
+        runs_for = parent.runs_for;
+    }
+    state
+}
+
+fn effective_of(threads: &Threads, thread: ThreadId) -> Option<ModelGuardEvent> {
+    threads
+        .get(&thread)
+        .map(|followed| effective(threads, followed))
+}
+
+/// Whether the guard follows `thread` and `model` is not its selection.
+pub(crate) fn other_than_selection(thread: ThreadId, model: &str) -> bool {
+    lock()
+        .get(&thread)
+        .is_some_and(|followed| !same_model(&followed.state.selected_model, model))
+}
+
+/// The state of a thread the guard follows.
+pub fn state(thread: ThreadId) -> Option<ModelGuardEvent> {
+    effective_of(&lock(), thread)
+}
+
+/// The user selected `model` for `thread`: it becomes the selection, and the
+/// holds of the thread and of every thread run on its behalf are lifted.
+/// Selecting the model already selected lifts them as well. A thread run on
+/// behalf of a thread that is still held stays held with it.
+pub fn select(thread: ThreadId, model: &str) -> Option<ModelGuardEvent> {
+    let mut threads = lock();
+    let followed = threads.get_mut(&thread)?;
+    followed.state.selected_model = model.to_owned();
+    followed.state.hold = None;
+    let released: Vec<ThreadId> = threads
+        .iter()
+        .filter(|(_, followed)| runs_on_behalf_of(&threads, followed, thread))
+        .map(|(id, _)| *id)
+        .collect();
+    for id in released {
+        if let Some(followed) = threads.get_mut(&id) {
+            followed.state.hold = None;
+        }
+    }
+    effective_of(&threads, thread)
+}
+
+/// Whether `followed` runs on behalf of `ancestor`, directly or through
+/// threads that run on its behalf.
+fn runs_on_behalf_of(threads: &Threads, followed: &Followed, ancestor: ThreadId) -> bool {
+    let mut runs_for = followed.runs_for;
+    // Each step goes to another followed thread, so the walk ends within the
+    // registry's size even on a malformed chain.
+    for _ in 0..threads.len() {
+        let Some(parent) = runs_for else {
+            return false;
+        };
+        if parent == ancestor {
+            return true;
+        }
+        runs_for = threads.get(&parent).and_then(|parent| parent.runs_for);
+    }
+    false
+}
+
+/// Holds `thread` for the opt-in reasoning heuristic, which the client
+/// measures, unless a stronger cause already holds it.
+pub fn hold_for_reasoning(thread: ThreadId, hits: u32) -> Option<ModelGuardEvent> {
+    hold(thread, ModelGuardHold::Reasoning { hits }).map(|(state, _)| state)
+}
+
+/// Admits a request for `requested` on `thread`. A held thread admits
+/// nothing, and a request for a model other than the selection holds it.
+/// The refusal carries the thread's state and whether it changed.
+pub(crate) fn admit(thread: ThreadId, requested: &str) -> Result<(), Refusal> {
+    let mut threads = lock();
+    let Some(state) = effective_of(&threads, thread) else {
+        return Ok(());
+    };
+    if state.hold.is_some() {
+        return Err(Refusal {
+            state,
+            changed: false,
+        });
+    }
+    if same_model(&state.selected_model, requested) {
+        return Ok(());
+    }
+    let cause = ModelGuardHold::Request {
+        selected: state.selected_model,
+        requested: requested.to_owned(),
+    };
+    match hold_locked(&mut threads, thread, cause) {
+        Some((state, changed)) => Err(Refusal { state, changed }),
+        None => Ok(()),
+    }
+}
+
+/// Refuses work a held thread starts outside a model request, such as a
+/// voice conversation.
+pub(crate) fn refuse_if_held(thread: ThreadId) -> Result<(), CodexErr> {
+    match state(thread) {
+        Some(state) if state.hold.is_some() => Err(held_error(&state)),
+        _ => Ok(()),
+    }
+}
+
+/// Stops following `thread`, whose session runs without the guard.
+pub(crate) fn forget(thread: ThreadId) {
+    lock().remove(&thread);
+}
+
+/// Checks a request that only prepares a later one (a connection warmup with
+/// `generate=false`). It is refused exactly when `admit` would refuse the
+/// request it prepares, but the refusal leaves the thread's state as it is:
+/// the prepared request is judged when it is made, against the selection in
+/// force then.
+pub(crate) fn admit_preparation(thread: ThreadId, requested: &str) -> Result<(), CodexErr> {
+    let Some(state) = state(thread) else {
+        return Ok(());
+    };
+    if state.hold.is_some() {
+        return Err(held_error(&state));
+    }
+    if same_model(&state.selected_model, requested) {
+        return Ok(());
+    }
+    Err(CodexErr::ModelGuardHeld(format!(
+        "Model Guard sends no warmup for {requested}: the selected model is {}.",
+        state.selected_model
+    )))
+}
+
+/// Judges what a response disclosed about the model that served a request
+/// for `requested`; the effective-model header outranks the body label. A
+/// disclosure of another model holds the thread; the result is its state and
+/// whether this disclosure changed it.
+pub(crate) fn observe(
+    thread: ThreadId,
+    requested: &str,
+    server_model: Option<&str>,
+    response_label: Option<&str>,
+) -> Option<(ModelGuardEvent, bool)> {
+    let cause = if let Some(actual) = server_model.filter(|actual| !same_model(actual, requested)) {
+        ModelGuardHold::Route {
+            requested: requested.to_owned(),
+            actual: actual.to_owned(),
+        }
+    } else if let Some(label) = response_label.filter(|label| !label_consistent(requested, label)) {
+        ModelGuardHold::Label {
+            requested: requested.to_owned(),
+            label: label.to_owned(),
+        }
+    } else {
+        return None;
+    };
+    hold(thread, cause)
+}
+
+/// A request Model Guard refused, with the thread's state.
+pub(crate) struct Refusal {
+    pub(crate) state: ModelGuardEvent,
+    /// The refusal itself held the thread.
+    pub(crate) changed: bool,
+}
+
+impl Refusal {
+    pub(crate) fn into_error(self) -> CodexErr {
+        held_error(&self.state)
+    }
+}
+
+/// The terminal error that ends a turn on a held thread.
+pub(crate) fn held_error(state: &ModelGuardEvent) -> CodexErr {
+    let cause = match &state.hold {
+        Some(ModelGuardHold::Request {
+            selected,
+            requested,
+        }) => format!("the request named {requested}, not the selected {selected}"),
+        Some(ModelGuardHold::Route { requested, actual }) => {
+            format!("the server reported {actual} for a request to {requested}")
+        }
+        Some(ModelGuardHold::Label { requested, label }) => {
+            format!("the response to a request for {requested} was labeled {label}")
+        }
+        Some(ModelGuardHold::Reasoning { hits }) => {
+            format!("{hits} of the last five responses had exactly 516 reasoning tokens")
+        }
+        None => format!("the selected model is {}", state.selected_model),
+    };
+    CodexErr::ModelGuardHeld(format!(
+        "Model Guard holds this thread: {cause}. Select a model with /model to continue."
+    ))
+}
+
+/// Applies `cause` to a followed thread unless an equal or stronger cause
+/// already holds it. Returns the state and whether it changed.
+fn hold(thread: ThreadId, cause: ModelGuardHold) -> Option<(ModelGuardEvent, bool)> {
+    hold_locked(&mut lock(), thread, cause)
+}
+
+fn hold_locked(
+    threads: &mut Threads,
+    thread: ThreadId,
+    cause: ModelGuardHold,
+) -> Option<(ModelGuardEvent, bool)> {
+    let followed = threads.get_mut(&thread)?;
+    let changed = followed
+        .state
+        .hold
+        .as_ref()
+        .is_none_or(|current| rank(current) < rank(&cause));
+    if changed {
+        followed.state.hold = Some(cause);
+    }
+    Some((effective_of(threads, thread)?, changed))
+}
+
+/// A request for another model outranks what the server disclosed, and
+/// disclosures outrank the heuristic.
+fn rank(hold: &ModelGuardHold) -> u8 {
+    match hold {
+        ModelGuardHold::Request { .. } => 3,
+        ModelGuardHold::Route { .. } => 2,
+        ModelGuardHold::Label { .. } => 1,
+        ModelGuardHold::Reasoning { .. } => 0,
+    }
+}
+
+fn same_model(left: &str, right: &str) -> bool {
+    left.eq_ignore_ascii_case(right)
+}
+
+/// Whether a response body's model label describes the requested model.
+///
+/// Equal identifiers agree, and so does one identifier extending the other
+/// at a separator (`gpt-6-astra` and `gpt-6-astra-2026-09-01`, or the bare
+/// family `gpt-6`). A size tier appended to the requested model names a
+/// different model. Everything else, including another family, differs.
+pub fn label_consistent(requested: &str, label: &str) -> bool {
+    const SIZE_TIERS: [&str; 7] = ["mini", "nano", "lite", "small", "fast", "flash", "turbo"];
+    const SEPARATORS: [char; 5] = ['-', '.', ':', '_', '@'];
+    let requested = requested.to_ascii_lowercase();
+    let label = label.to_ascii_lowercase();
+    if requested == label {
+        return true;
+    }
+    let extension = |short: &str, long: &str| {
+        long.strip_prefix(short)
+            .filter(|rest| rest.starts_with(SEPARATORS))
+            .map(|rest| rest[1..].to_owned())
+    };
+    match extension(&requested, &label) {
+        Some(rest) => !rest
+            .split(SEPARATORS)
+            .any(|part| SIZE_TIERS.contains(&part)),
+        None => extension(&label, &requested).is_some(),
+    }
+}
+
+fn lock() -> std::sync::MutexGuard<'static, Threads> {
+    THREADS
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+}
+
+#[cfg(test)]
+#[path = "model_guard_tests.rs"]
+mod tests;
diff --git a/codex-rs/core/src/model_guard_tests.rs b/codex-rs/core/src/model_guard_tests.rs
new file mode 100644
index 00000000..db0fac71
--- /dev/null
+++ b/codex-rs/core/src/model_guard_tests.rs
@@ -0,0 +1,274 @@
+use super::*;
+use pretty_assertions::assert_eq;
+
+fn user(thread: ThreadId, configured: Option<&str>, model: &str) -> ModelGuardEvent {
+    follow(
+        thread,
+        Origin::User {
+            configured: configured.map(str::to_owned),
+        },
+        model,
+    )
+}
+
+fn request_hold(selected: &str, requested: &str) -> Option<ModelGuardHold> {
+    Some(ModelGuardHold::Request {
+        selected: selected.into(),
+        requested: requested.into(),
+    })
+}
+
+#[test]
+fn a_thread_restored_on_another_model_is_held_from_the_start() {
+    let thread = ThreadId::new();
+    assert_eq!(
+        user(thread, Some("gpt-6-astra"), "gpt-reserve").hold,
+        request_hold("gpt-6-astra", "gpt-reserve")
+    );
+    // Following it again keeps what the process remembers.
+    assert_eq!(
+        user(thread, Some("gpt-6-sol"), "gpt-6-sol").selected_model,
+        "gpt-6-astra"
+    );
+    // Without a configured model the thread's own model is the selection.
+    let other = ThreadId::new();
+    assert_eq!(
+        user(other, None, "gpt-6-sol"),
+        ModelGuardEvent {
+            selected_model: "gpt-6-sol".into(),
+            hold: None,
+        }
+    );
+}
+
+#[test]
+fn admission_holds_a_request_for_another_model_and_then_admits_nothing() {
+    let thread = ThreadId::new();
+    user(thread, Some("gpt-6-astra"), "gpt-6-astra");
+    assert!(admit(thread, "GPT-6-ASTRA").is_ok());
+    let refusal = admit(thread, "gpt-reserve").unwrap_err();
+    assert!(refusal.changed);
+    assert_eq!(
+        refusal.state.hold,
+        request_hold("gpt-6-astra", "gpt-reserve")
+    );
+    // The held thread admits not even its selected model.
+    let refusal = admit(thread, "gpt-6-astra").unwrap_err();
+    assert!(!refusal.changed);
+    assert!(
+        refusal
+            .into_error()
+            .to_string()
+            .contains("the request named gpt-reserve, not the selected gpt-6-astra")
+    );
+    // A thread the guard does not follow is never refused.
+    assert!(admit(ThreadId::new(), "gpt-reserve").is_ok());
+}
+
+#[test]
+fn a_warmup_is_sent_only_for_the_selection_and_never_holds() {
+    let thread = ThreadId::new();
+    user(thread, Some("gpt-6-astra"), "gpt-6-astra");
+    assert!(admit_preparation(thread, "gpt-6-astra").is_ok());
+    assert!(admit_preparation(thread, "gpt-reserve").is_err());
+    assert_eq!(state(thread).and_then(|state| state.hold), None);
+    assert!(admit(thread, "gpt-6-astra").is_ok());
+    // A held thread prepares nothing, not even for its selection.
+    let held = ThreadId::new();
+    user(held, Some("gpt-6-astra"), "gpt-reserve");
+    assert!(admit_preparation(held, "gpt-6-astra").is_err());
+    assert!(admit_preparation(ThreadId::new(), "gpt-reserve").is_ok());
+}
+
+#[test]
+fn disclosures_hold_the_thread_in_rank_order() {
+    let thread = ThreadId::new();
+    user(thread, Some("gpt-6-astra"), "gpt-6-astra");
+    assert_eq!(
+        observe(
+            thread,
+            "gpt-6-astra",
+            Some("gpt-6-astra"),
+            Some("gpt-6-astra-2026-09-01")
+        ),
+        None
+    );
+    let (state, changed) = observe(thread, "gpt-6-astra", None, Some("gpt-6-astra-mini")).unwrap();
+    assert!(changed);
+    assert_eq!(
+        state.hold,
+        Some(ModelGuardHold::Label {
+            requested: "gpt-6-astra".into(),
+            label: "gpt-6-astra-mini".into(),
+        })
+    );
+    // A header outranks the label; the label alone again changes nothing.
+    let (state, changed) = observe(thread, "gpt-6-astra", Some("gpt-4o"), None).unwrap();
+    assert!(changed);
+    assert!(matches!(state.hold, Some(ModelGuardHold::Route { .. })));
+    let (_, changed) = observe(thread, "gpt-6-astra", None, Some("gpt-4o")).unwrap();
+    assert!(!changed);
+    // The heuristic never replaces a disclosure.
+    assert!(matches!(
+        hold_for_reasoning(thread, 3).unwrap().hold,
+        Some(ModelGuardHold::Route { .. })
+    ));
+}
+
+#[test]
+fn only_the_users_selection_lifts_a_hold() {
+    let thread = ThreadId::new();
+    user(thread, Some("gpt-6-astra"), "gpt-6-astra");
+    assert_eq!(
+        hold_for_reasoning(thread, 3).unwrap().hold,
+        Some(ModelGuardHold::Reasoning { hits: 3 })
+    );
+    assert!(admit(thread, "gpt-6-astra").is_err());
+    // Selecting the same model again counts.
+    assert_eq!(
+        select(thread, "gpt-6-astra"),
+        Some(ModelGuardEvent {
+            selected_model: "gpt-6-astra".into(),
+            hold: None,
+        })
+    );
+    assert!(admit(thread, "gpt-6-astra").is_ok());
+    select(thread, "gpt-6-sol");
+    assert!(other_than_selection(thread, "gpt-6-astra"));
+    assert!(!other_than_selection(thread, "gpt-6-sol"));
+    assert!(!other_than_selection(ThreadId::new(), "gpt-6-astra"));
+    assert_eq!(select(ThreadId::new(), "gpt-6-sol"), None);
+}
+
+#[test]
+fn forks_carry_their_parents_state_and_children_their_parents_hold() {
+    let parent = ThreadId::new();
+    user(parent, Some("gpt-6-astra"), "gpt-6-astra");
+    select(parent, "gpt-6-sol");
+    let fork = ThreadId::new();
+    let fork_state = follow(
+        fork,
+        Origin::Fork {
+            parent,
+            configured: Some("gpt-6-astra".into()),
+        },
+        "gpt-6-sol",
+    );
+    assert_eq!(fork_state.selected_model, "gpt-6-sol");
+    assert_eq!(fork_state.hold, None);
+    // A child runs on its own configured model.
+    let child = ThreadId::new();
+    assert_eq!(
+        follow(child, Origin::Child { parent }, "gpt-6-luna"),
+        ModelGuardEvent {
+            selected_model: "gpt-6-luna".into(),
+            hold: None,
+        }
+    );
+    // A fork or child of a held thread starts held.
+    let _ = admit(parent, "gpt-reserve");
+    let held_fork = follow(
+        ThreadId::new(),
+        Origin::Fork {
+            parent,
+            configured: None,
+        },
+        "gpt-6-sol",
+    );
+    assert_eq!(held_fork.hold, request_hold("gpt-6-sol", "gpt-reserve"));
+    let held_child = follow(ThreadId::new(), Origin::Child { parent }, "gpt-6-luna");
+    assert_eq!(held_child.selected_model, "gpt-6-luna");
+    assert_eq!(held_child.hold, request_hold("gpt-6-sol", "gpt-reserve"));
+    // A fork of a thread the process does not know uses the configured model.
+    let orphan = follow(
+        ThreadId::new(),
+        Origin::Fork {
+            parent: ThreadId::new(),
+            configured: Some("gpt-6-astra".into()),
+        },
+        "gpt-reserve",
+    );
+    assert_eq!(orphan.hold, request_hold("gpt-6-astra", "gpt-reserve"));
+}
+
+#[test]
+fn a_child_is_held_exactly_while_a_thread_it_runs_for_is_held() {
+    let parent = ThreadId::new();
+    user(parent, Some("gpt-6-astra"), "gpt-6-astra");
+    let child = ThreadId::new();
+    follow(child, Origin::Child { parent }, "gpt-6-luna");
+    let grandchild = ThreadId::new();
+    follow(grandchild, Origin::Child { parent: child }, "gpt-6-luna");
+    assert!(admit(grandchild, "gpt-6-luna").is_ok());
+
+    // A hold that comes to the parent later reaches every thread run for it.
+    let _ = observe(parent, "gpt-6-astra", Some("gpt-4o"), None);
+    let refusal = admit(grandchild, "gpt-6-luna").unwrap_err();
+    assert!(!refusal.changed);
+    assert!(matches!(
+        refusal.state.hold,
+        Some(ModelGuardHold::Route { .. })
+    ));
+    assert_eq!(
+        state(child).and_then(|state| state.hold),
+        state(parent).and_then(|state| state.hold)
+    );
+
+    // The user's selection on the parent releases them with it.
+    select(parent, "gpt-6-astra");
+    assert!(admit(child, "gpt-6-luna").is_ok());
+    assert!(admit(grandchild, "gpt-6-luna").is_ok());
+
+    // A child's own hold stays its own.
+    let _ = admit(child, "gpt-reserve");
+    assert!(admit(parent, "gpt-6-astra").is_ok());
+    assert!(admit(grandchild, "gpt-6-luna").is_err());
+
+    // A thread with no selection of its own is released by the user's
+    // selection on the thread it runs for; another thread's children are not.
+    let other = ThreadId::new();
+    user(other, Some("gpt-6-astra"), "gpt-6-astra");
+    let other_child = ThreadId::new();
+    follow(other_child, Origin::Child { parent: other }, "gpt-6-luna");
+    let _ = admit(other_child, "gpt-reserve");
+    select(parent, "gpt-6-astra");
+    assert!(admit(child, "gpt-6-luna").is_ok());
+    assert!(admit(grandchild, "gpt-6-luna").is_ok());
+    assert!(admit(other_child, "gpt-6-luna").is_err());
+}
+
+/// The same table holds the Python observer to the same rule.
+#[test]
+fn label_consistency_rule() {
+    for (requested, label, expected) in [
+        ("gpt-6-astra", "gpt-6-astra", true),
+        ("GPT-6-Astra", "gpt-6-astra", true),
+        ("gpt-6-astra", "gpt-6-astra-2026-09-01", true),
+        ("gpt-6-astra", "gpt-6", true),
+        ("gpt-5.6-sol", "gpt-5.6-sol-codex", true),
+        ("gpt-6-astra", "gpt-4o", false),
+        ("gpt-6-astra", "gpt-6-astra-mini", false),
+        ("gpt-6-astra", "gpt-6-astrax", false),
+        ("gpt-6-astra", "gpt-5.6-sol", false),
+    ] {
+        assert_eq!(
+            label_consistent(requested, label),
+            expected,
+            "{requested} vs {label}"
+        );
+    }
+}
+
+#[test]
+fn a_held_thread_starts_no_voice_conversation_and_a_disabled_one_is_forgotten() {
+    let thread = ThreadId::new();
+    user(thread, Some("gpt-6-astra"), "gpt-6-astra");
+    assert!(refuse_if_held(thread).is_ok());
+    let _ = admit(thread, "gpt-reserve");
+    assert!(refuse_if_held(thread).is_err());
+    // A session that runs without the guard leaves no hold behind.
+    forget(thread);
+    assert_eq!(state(thread), None);
+    assert!(refuse_if_held(thread).is_ok());
+    assert!(admit(thread, "gpt-reserve").is_ok());
+}
