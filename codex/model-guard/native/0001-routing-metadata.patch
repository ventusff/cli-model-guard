@@ -0,0 +1,258 @@
+//! Model Guard holds a thread at the point every model request passes: a held
+//! thread sends nothing, whoever starts its turn.
+use std::sync::Arc;
+
+use anyhow::Result;
+use codex_core::TurnInputRequest;
+use codex_core::compact::SUMMARIZATION_PROMPT;
+use codex_core::model_guard;
+use codex_login::CodexAuth;
+use codex_model_provider_info::built_in_model_providers;
+use codex_protocol::ThreadId;
+use codex_protocol::config_types::CollaborationMode;
+use codex_protocol::config_types::ModeKind;
+use codex_protocol::config_types::Settings;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::ModelGuardEvent;
+use codex_protocol::protocol::ModelGuardHold;
+use codex_protocol::protocol::ThreadSettingsOverrides;
+use codex_protocol::user_input::UserInput;
+use core_test_support::responses::ev_assistant_message;
+use core_test_support::responses::ev_completed;
+use core_test_support::responses::ev_response_created;
+use core_test_support::responses::mount_response_once;
+use core_test_support::responses::sse;
+use core_test_support::responses::sse_response;
+use core_test_support::responses::start_mock_server;
+use core_test_support::responses::start_websocket_server;
+use core_test_support::skip_if_no_network;
+use core_test_support::test_codex::TestCodex;
+use core_test_support::test_codex::test_codex;
+use core_test_support::wait_for_event;
+use pretty_assertions::assert_eq;
+use tempfile::TempDir;
+use wiremock::MockServer;
+
+const SELECTED: &str = "gpt-6-astra";
+
+fn guarded_home() -> Result<Arc<TempDir>> {
+    let home = TempDir::new()?;
+    std::fs::write(
+        home.path().join("config.toml"),
+        "[features]\nplugins = true\n\n[plugins.\"model-guard@test\"]\nenabled = true\n",
+    )?;
+    Ok(Arc::new(home))
+}
+
+fn turn(text: &str, model: Option<&str>) -> TurnInputRequest {
+    let request = TurnInputRequest::user_input(vec![UserInput::Text {
+        text: text.into(),
+        text_elements: Vec::new(),
+    }]);
+    match model {
+        Some(model) => request.with_thread_settings(ThreadSettingsOverrides {
+            collaboration_mode: Some(CollaborationMode {
+                mode: ModeKind::Default,
+                settings: Settings {
+                    model: model.to_owned(),
+                    reasoning_effort: None,
+                    developer_instructions: None,
+                },
+            }),
+            ..Default::default()
+        }),
+        None => request,
+    }
+}
+
+/// Runs a turn to its end; returns the guard states and errors it reported.
+async fn run(
+    test: &TestCodex,
+    request: TurnInputRequest,
+) -> Result<(Vec<ModelGuardEvent>, Vec<String>)> {
+    test.codex.start_or_steer_turn(request).await?;
+    let (mut states, mut errors) = (Vec::new(), Vec::new());
+    loop {
+        match wait_for_event(&test.codex, |_| true).await {
+            EventMsg::ModelGuard(state) => states.push(state),
+            EventMsg::Error(error) => errors.push(error.message),
+            EventMsg::TurnComplete(_) => break,
+            _ => {}
+        }
+    }
+    Ok((states, errors))
+}
+
+async fn model_requests(server: &MockServer) -> Vec<String> {
+    server
+        .received_requests()
+        .await
+        .unwrap_or_default()
+        .iter()
+        .filter(|request| request.url.path().ends_with("/responses"))
+        .filter_map(|request| {
+            serde_json::from_slice::<serde_json::Value>(&request.body)
+                .ok()?
+                .get("model")?
+                .as_str()
+                .map(str::to_owned)
+        })
+        .collect()
+}
+
+fn ok_response(id: &str) -> wiremock::ResponseTemplate {
+    sse_response(sse(vec![
+        ev_assistant_message(&format!("{id}-message"), "OK"),
+        ev_completed(id),
+    ]))
+}
+
+fn thread(test: &TestCodex) -> ThreadId {
+    test.session_configured.thread_id
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn a_response_from_another_model_holds_the_thread_until_the_user_selects() -> Result<()> {
+    let server = start_mock_server().await;
+    mount_response_once(
+        &server,
+        ok_response("first").insert_header("OpenAI-Model", "gpt-4o"),
+    )
+    .await;
+    let test = test_codex()
+        .with_home(guarded_home()?)
+        .with_model(SELECTED)
+        .build_with_auto_env(&server)
+        .await?;
+
+    let (states, errors) = run(&test, turn("First.", None)).await?;
+    assert_eq!(
+        states.last().and_then(|state| state.hold.clone()),
+        Some(ModelGuardHold::Route {
+            requested: SELECTED.into(),
+            actual: "gpt-4o".into(),
+        })
+    );
+    assert!(
+        errors
+            .iter()
+            .any(|error| error.contains("Model Guard holds this thread"))
+    );
+
+    // The held thread sends nothing: not the user's next turn.
+    let (_, errors) = run(&test, turn("Second.", None)).await?;
+    assert!(!errors.is_empty());
+    assert_eq!(model_requests(&server).await, [SELECTED]);
+
+    // Selecting the model, even the same one, is the way out.
+    model_guard::select(thread(&test), SELECTED);
+    mount_response_once(&server, ok_response("third")).await;
+    let (states, errors) = run(&test, turn("Third.", None)).await?;
+    assert_eq!((states, errors), (Vec::new(), Vec::new()));
+    assert_eq!(model_requests(&server).await, [SELECTED, SELECTED]);
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn a_request_for_another_model_is_never_sent() -> Result<()> {
+    let server = start_mock_server().await;
+    let test = test_codex()
+        .with_home(guarded_home()?)
+        .with_model(SELECTED)
+        .build_with_auto_env(&server)
+        .await?;
+    // The thread runs one model while the user's selection is another.
+    model_guard::select(thread(&test), "gpt-6-sol");
+
+    let (states, errors) = run(&test, turn("Hello.", None)).await?;
+    assert_eq!(
+        states.last().and_then(|state| state.hold.clone()),
+        Some(ModelGuardHold::Request {
+            selected: "gpt-6-sol".into(),
+            requested: SELECTED.into(),
+        })
+    );
+    assert!(
+        errors
+            .iter()
+            .any(|error| error.contains("not the selected gpt-6-sol"))
+    );
+    assert!(model_requests(&server).await.is_empty());
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn a_held_thread_sends_nothing_over_websockets() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let server = start_websocket_server(vec![vec![
+        vec![ev_response_created("warm"), ev_completed("warm")],
+        vec![
+            ev_response_created("first"),
+            ev_assistant_message("first-message", "OK"),
+            ev_completed("first"),
+        ],
+    ]])
+    .await;
+    let test = test_codex()
+        .with_home(guarded_home()?)
+        .build_with_websocket_server(&server)
+        .await?;
+    let model = test.session_configured.model.clone();
+
+    let (states, errors) = run(&test, turn("First.", None)).await?;
+    assert_eq!((states, errors), (Vec::new(), Vec::new()));
+
+    // The thread runs one model while the user's selection is another.
+    model_guard::select(thread(&test), "gpt-6-sol");
+    let (_, errors) = run(&test, turn("Second.", None)).await?;
+    assert!(
+        errors
+            .iter()
+            .any(|error| error.contains("not the selected gpt-6-sol"))
+    );
+    let generated: Vec<String> = server
+        .connections()
+        .iter()
+        .flatten()
+        .map(|request| request.body_json())
+        .filter(|body| body["generate"].as_bool() != Some(false))
+        .filter_map(|body| body["model"].as_str().map(str::to_owned))
+        .collect();
+    assert_eq!(generated, [model]);
+    server.shutdown().await;
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn the_selected_model_summarizes_a_history_another_model_wrote() -> Result<()> {
+    let server = start_mock_server().await;
+    let (previous, next) = ("gpt-6-luna", SELECTED);
+    // A provider without remote compaction, so the summary is an ordinary request.
+    let mut provider = built_in_model_providers(/*openai_base_url*/ None)["openai"].clone();
+    provider.name = "OpenAI (test)".into();
+    provider.base_url = Some(format!("{}/v1", server.uri()));
+    provider.supports_websockets = false;
+    let test = test_codex()
+        .with_home(guarded_home()?)
+        .with_auth(CodexAuth::create_dummy_chatgpt_auth_for_testing())
+        .with_model_info_override(next, |model| model.comp_hash = Some("hash-b".into()))
+        .with_model_info_override(previous, |model| model.comp_hash = Some("hash-a".into()))
+        .with_config(move |config| {
+            config.model_provider = provider;
+            config.compact_prompt = Some(SUMMARIZATION_PROMPT.to_owned());
+        })
+        .build(&server)
+        .await?;
+    mount_response_once(&server, ok_response("before")).await;
+    run(&test, turn("Before.", None)).await?;
+
+    // The user leaves the previous model; Codex compacts before the first
+    // turn on the new one, with the new one.
+    model_guard::select(thread(&test), next);
+    mount_response_once(&server, ok_response("summary")).await;
+    mount_response_once(&server, ok_response("after")).await;
+    let (states, errors) = run(&test, turn("After.", Some(next))).await?;
+    assert_eq!((states, errors), (Vec::new(), Vec::new()));
+    assert_eq!(model_requests(&server).await, [previous, next, next]);
+    Ok(())
+}
diff --git a/codex-rs/core/tests/suite/model_routing.rs b/codex-rs/core/tests/suite/model_routing.rs
new file mode 100644
index 00000000..409284bf
--- /dev/null
+++ b/codex-rs/core/tests/suite/model_routing.rs
@@ -0,0 +1,93 @@
+//! Routing disclosures are metadata, not a model identity attestation.
+use anyhow::Result;
+use codex_core::TurnInputRequest;
+use codex_protocol::openai_models::ReasoningEffort;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::user_input::UserInput;
+use core_test_support::responses::ev_completed;
+use core_test_support::responses::mount_response_once;
+use core_test_support::responses::sse;
+use core_test_support::responses::sse_response;
+use core_test_support::responses::start_mock_server;
+use core_test_support::test_codex::test_codex;
+use core_test_support::wait_for_event;
+use pretty_assertions::assert_eq;
+use test_case::test_case;
+
+#[test_case(None, ReasoningEffort::Max; "missing disclosure stays unverified even with a body model")]
+#[test_case(Some("gpt-6-astra"), ReasoningEffort::Max; "matching header is disclosed")]
+#[test_case(Some("gpt-4o"), ReasoningEffort::Max; "different header is disclosed")]
+#[test_case(None, ReasoningEffort::Ultra; "ultra metadata follows the wire request")]
+#[test_case(None, ReasoningEffort::Persistent; "persistent metadata follows the wire request")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn model_routing_reports_only_effective_transport_metadata(
+    header: Option<&str>,
+    effort: ReasoningEffort,
+) -> Result<()> {
+    let server = start_mock_server().await;
+    let body = sse(vec![
+        serde_json::json!({"type":"response.created", "response":{"id":"routing-response", "model":"gpt-4o"}}),
+        ev_completed("routing-response"),
+    ]);
+    let response = match header {
+        Some(header) => sse_response(body).insert_header("OpenAI-Model", header),
+        None => sse_response(body),
+    };
+    let mock = mount_response_once(&server, response).await;
+    let mut builder = test_codex()
+        .with_model("gpt-6-astra")
+        .with_config(move |config| {
+            config.model_reasoning_effort = Some(effort);
+            config.service_tier = Some("default".into());
+        });
+    let test = builder.build_with_auto_env(&server).await?;
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "Reply OK without tools.".into(),
+            text_elements: Vec::new(),
+        }]))
+        .await?;
+    let mut routing = Vec::new();
+    loop {
+        match wait_for_event(&test.codex, |_| true).await {
+            EventMsg::ModelRouting(metadata) => routing.push(metadata),
+            EventMsg::TurnComplete(_) => break,
+            _ => {}
+        }
+    }
+    let first = routing.first().expect("sampling request metadata");
+    assert_eq!(
+        (&first.requested_model, first.server_model.as_ref()),
+        (&"gpt-6-astra".to_string(), None)
+    );
+    assert!(!first.request_id.is_empty());
+    // The body label is reported on its own; it never becomes the server model.
+    let mut expected = vec![(None, None)];
+    if let Some(header) = header {
+        expected.push((Some(header.to_string()), None));
+    }
+    expected.push((header.map(str::to_string), Some("gpt-4o".to_string())));
+    assert_eq!(
+        routing
+            .iter()
+            .map(|r| (r.server_model.clone(), r.response_label.clone()))
+            .collect::<Vec<_>>(),
+        expected
+    );
+    assert!(routing.iter().all(|r| r.request_id == first.request_id));
+    let request = mock.single_request().body_json();
+    assert_eq!(
+        first.requested_model,
+        request["model"].as_str().expect("request model")
+    );
+    assert_eq!(
+        first.reasoning_effort.as_deref(),
+        request["reasoning"]["effort"].as_str()
+    );
+    assert_eq!(
+        first.service_tier.as_deref(),
+        request["service_tier"].as_str()
+    );
+    assert_eq!(first.service_tier, None);
+    Ok(())
+}
