@@ -60,6 +60,55 @@ pub fn get_upgrade_version(config: &Config) -> Option<String> {
 // We use the latest version from the cask if installation is via homebrew - homebrew does not immediately pick up the latest release and can lag behind.
 const HOMEBREW_CASK_API_URL: &str = "https://formulae.brew.sh/api/cask/codex.json";
 const LATEST_RELEASE_URL: &str = "https://api.github.com/repos/openai/codex/releases/latest";
+// A Model Guard build can only move to the Codex version its plugin tracks.
+const MODEL_GUARD_RELEASE_URL: &str =
+    "https://raw.githubusercontent.com/ventusff/cli-model-guard/main/codex/model-guard/native/release.json";
+
+#[derive(Deserialize, Debug, Clone)]
+struct ModelGuardRelease {
+    codex_version: String,
+    plugin_version: String,
+}
+
+/// This build's plugin version, set by the package build.
+const MODEL_GUARD_VERSION: &str = match option_env!("MODEL_GUARD_VERSION") {
+    Some(version) => version,
+    None => "dev",
+};
+
+/// A Model Guard build installs the plugin's newer release itself, unless
+/// `auto_update` is false in the installation's `config.json`: the updater
+/// runs detached with its output in `update.log`, once per release, and new
+/// sessions use what it installed.
+fn model_guard_auto_update(release: &ModelGuardRelease) {
+    let Some(root) = crate::update_action::model_guard_root() else {
+        return;
+    };
+    let Some(marker) = crate::update_action::model_guard_auto_update_marker(
+        &root,
+        &release.plugin_version,
+        MODEL_GUARD_VERSION,
+    ) else {
+        return;
+    };
+    let Ok(log) = std::fs::File::create(root.join("update.log")) else {
+        return;
+    };
+    let Ok(errors) = log.try_clone() else {
+        return;
+    };
+    if std::fs::write(&marker, format!("{}\n", release.plugin_version)).is_err() {
+        return;
+    }
+    let _ = std::process::Command::new("setsid")
+        .arg("-f")
+        .arg(crate::update_action::model_guard_updater(&root))
+        .arg("update")
+        .stdin(std::process::Stdio::null())
+        .stdout(log)
+        .stderr(errors)
+        .spawn();
+}
 
