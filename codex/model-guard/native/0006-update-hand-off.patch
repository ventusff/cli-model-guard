+/// The Model Guard installation root: `MODEL_GUARD_CODEX_HOME`, or the
+/// default under the home directory.
+#[cfg(not(debug_assertions))]
+pub(crate) fn model_guard_root() -> Option<std::path::PathBuf> {
+    std::env::var_os("MODEL_GUARD_CODEX_HOME")
+        .map(std::path::PathBuf::from)
+        .or_else(|| dirs::home_dir().map(|home| home.join(".local/share/model-guard-codex")))
+}
+
+/// The file that records an attempt to install plugin release `available`, or
+/// None when there is nothing to do: the version is installed, `auto_update`
+/// is false in the installation's `config.json`, or the attempt was made.
+#[cfg(any(not(debug_assertions), test))]
+pub(crate) fn model_guard_auto_update_marker(
+    root: &std::path::Path,
+    available: &str,
+    installed: &str,
+) -> Option<std::path::PathBuf> {
+    if available == installed {
+        return None;
+    }
+    let enabled = std::fs::read(root.join("config.json"))
+        .ok()
+        .and_then(|bytes| serde_json::from_slice::<serde_json::Value>(&bytes).ok())
+        .and_then(|config| config.get("auto_update")?.as_bool())
+        .unwrap_or(true);
+    if !enabled {
+        return None;
+    }
+    let marker = root.join(format!("auto-update.{available}"));
+    (!marker.exists()).then_some(marker)
+}
+
+/// The updater next to the installed entry, or the one on `PATH`.
+#[cfg(any(not(debug_assertions), test))]
+pub(crate) fn model_guard_updater(root: &std::path::Path) -> std::path::PathBuf {
+    std::fs::read(root.join("install.json"))
+        .ok()
+        .and_then(|bytes| serde_json::from_slice::<serde_json::Value>(&bytes).ok())
+        .and_then(|state| Some(std::path::PathBuf::from(state.get("entry")?.as_str()?)))
+        .and_then(|entry| Some(entry.parent()?.join("model-guard-codex")))
+        .filter(|updater| updater.is_file())
+        .unwrap_or_else(|| std::path::PathBuf::from("model-guard-codex"))
+}
+
+/// Whether `exe` is one of the versioned native packages under the Model
+/// Guard installation root. Both paths are canonicalized, so the entry
+/// symlink and the package directory are compared by what they resolve to.
+#[cfg(any(not(debug_assertions), test))]
+fn runs_from_model_guard(root: Option<&std::path::Path>, exe: Option<&std::path::Path>) -> bool {
+    let (Some(root), Some(exe)) = (root, exe) else {
+        return false;
+    };
+    match (
+        std::fs::canonicalize(root.join("native")),
+        std::fs::canonicalize(exe),
+    ) {
+        (Ok(native), Ok(exe)) => exe.starts_with(native),
+        _ => false,
+    }
+}
